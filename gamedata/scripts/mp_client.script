-- MP fork (§14 co-op thin client): client-side gamedata init.
-- Called ONCE per level by the engine (CLevel::InitializeClientGame) on a
-- co-op client, at config time BEFORE any object binder or spawn runs. This is
-- where we initialise the server-side gamedata globals that single-player code
-- references raw but that a thin client's normal init paths never create.
--
-- Keep every init here CLIENT-SAFE (no alife()/server writes): the authoritative
-- world lives on the server; the client only needs these globals to EXIST so
-- stock references resolve to empty/no-op instead of indexing nil.

function on_client_level_start()
	-- SIMBOARD: bind_campfire.script:273 (and others) index the global
	-- SIMBOARD raw. get_sim_board() lazily builds an EMPTY simulation_board
	-- (sim_board.script: __init only sets empty tables — client-safe), so the
	-- campfire/smart lookups resolve to nil and skip, which is correct on a
	-- client that owns no A-Life.
	sim_board.get_sim_board()

	-- PDA (§18): on the co-op thin client the engine's on_game_start callback never
	-- fires (it is driven by the A-Life simulator, which a thin client has none of),
	-- so stock pda.pda_use() returns false and opening the PDA does nothing (the
	-- engine path is otherwise correct: CurrentEntity is the owned actor, alive,
	-- AF_3D_PDA off). Patch pda.pda_use to allow the PDA to open on the co-op client.
	-- on_client_level_start runs on the client (unlike on_game_start), so this sticks.
	local ok, err = pcall(function()
		if pda and pda.pda_use then
			pda.pda_use = function(...) return true end -- allow PDA to open on the co-op client
			printf("~ MP co-op: patched pda.pda_use")
		end
	end)
	if not ok then printf("! MP co-op: pda.pda_use patch failed: %s", tostring(err)) end

	-- DRIFT PROBE (§14 step 4 increment 1, measure-only): arm BEFORE the registration below,
	-- because that line COPIES mp_coop_decision_client.on_decision into the global. The probe
	-- wraps the TABLE FIELD, so the copy carries the wrapper; arming after it would leave the
	-- global holding the unwrapped original and the probe would look installed while measuring
	-- nothing. Self-disables without -coop_drift_probe and prints either way.
	local okdp, errdp = pcall(function() zzz_mp_coop_driftprobe.arm() end)
	if not okdp then printf("! MP co-op: drift probe arm failed: %s", tostring(errdp)) end

	-- DECISION REPLICATION (§4): register the client-side executor for scheduled server
	-- decisions. The engine (CLevel::coop_dispatch_due_decisions) calls _G.mp_coop_on_decision
	-- when a decision fires on the shared clock. on_game_start never runs on the thin client,
	-- so it MUST be registered here. Referencing mp_coop_decision_client also loads that file.
	local okd, errd = pcall(function()
		_G.mp_coop_on_decision = mp_coop_decision_client.on_decision
		printf("~ MP co-op: registered mp_coop_on_decision (decision replication)")
	end)
	if not okd then printf("! MP co-op: mp_coop_on_decision register failed: %s", tostring(errd)) end

	-- LEVEL-TRANSITION CONDITION GUARD: GAMMA's is_actor_inside_lc indexes `actor` as its first
	-- act, and during a join the condlist is evaluated before the client's actor global is bound,
	-- so it RAISES — and GAMMA's fallback for a failed condition is to offer the trip, which is
	-- the "Move to the Darkscape?" modal every co-op join has been meeting. on_game_start never
	-- runs here, so the guard has to be installed explicitly, exactly like the two above.
	local oklc, errlc = pcall(function() mp_coop_lc_guard.install_now() end)
	if not oklc then printf("! MP co-op: lc guard install failed: %s", tostring(errlc)) end

	-- db.actor REBIND ON ACTOR DESTROY: a client holds other players' bodies as actors, and since
	-- engine 7ea1e152 their net_destroy is delivered, so stock db.del_actor() nils the client's
	-- db.actor when the server expires an orphan — and the next actor_binder:update kills the
	-- client (bind_stalker:211). Same wrapper the server installs from on_game_start.
	local okrb, errrb = pcall(function() mp_coop_actor_rebind.install_now() end)
	if not okrb then printf("! MP co-op: actor rebind install failed: %s", tostring(errrb)) end

	-- design doc §10.1: "Sleeping does NOT fast-forward the world." The sleep dialog would only pretend (the engine refuses
	-- the time change on a client), so do not open it: say why instead. Wait/fast travel are refused by the engine alone.
	local oksl, errsl = pcall(function()
		if ui_sleep_dialog and ui_sleep_dialog.sleep then
			ui_sleep_dialog.sleep = function()
				local str = "Co-op: sleeping cannot skip time. The Zone runs on one clock for everyone."
				if actor_menu and actor_menu.set_msg then actor_menu.set_msg(1, str, 5) end
				printf("%s", "- COOP(time): sleep refused on the client (design doc §10.1)")
			end
			printf("%s", "~ MP co-op: sleep dialog replaced (no time skip in co-op)")
		end
	end)
	if not oksl then printf("! MP co-op: sleep override failed: %s", tostring(errsl)) end

	-- server notices (crash resume, checkpoint answers): the engine calls _G.mp_coop_on_notice, published here
	local oknot, errnot = pcall(function() mp_coop_notice.install_now() end)
	if not oknot then printf("! MP co-op: notice handler install failed: %s", tostring(errnot)) end
	-- §10.3 item 4: the holder's yes/no prompt for another player's ask (after the notice, whose hook it listens on)
	local okcui, errcui = pcall(function() mp_coop_consent_ui.install_now() end)
	if not okcui then printf("! MP co-op: consent prompt install failed: %s", tostring(errcui)) end

	-- mp_api (design doc §13.1): the read-only players surface for a voice-chat companion mod. It fills from the
	-- server's roster broadcast; on_game_start never runs here, so it is installed explicitly like the guards above.
	local okapi, errapi = pcall(function() mp_coop_api.install_now() end)
	if not okapi then printf("! MP co-op: mp_api install failed: %s", tostring(errapi)) end

	-- per-life mod state (arszi_psy's psy meter, ...) reset when a co-op player revives: the engine calls _G.mp_coop_on_respawn
	local okrr, errrr = pcall(function() mp_coop_respawn.install_now() end)
	if not okrr then printf("! MP co-op: respawn reset install failed: %s", tostring(errrr)) end

	-- PDA zone chat (design doc §13.4): after mp_api, so mp_api.chat can be published on it
	local okchat, errchat = pcall(function() mp_coop_chat.install_now() end)
	if not okchat then printf("! MP co-op: chat install failed: %s", tostring(errchat)) end

	-- xr_effects COMPLETENESS: the flat co-op gamedata lacks xr_effects_addon.script, so stock
	-- objects using the %=script()% effect nil-error at xr_logic:491. on_game_start never runs on the
	-- thin client, so define the missing xr_effects.script here too (referencing the module loads it).
	local oke, erre = pcall(function() zzz_mp_xr_effects_guards.ensure_xr_effects_script() end)
	if not oke then printf("! MP co-op: xr_effects guard (client) failed: %s", tostring(erre)) end

	-- MEET-DIALOG GUARD (2026-09-17, Caden's live crash): xr_meet's Cmeet_manager:update() can set an EMPTY
	-- start dialog, which aborts the client in CXML_IdToIndex<CPhraseDialog>::GetById the moment a conversation
	-- opens. The guard for it lives in zzz_mp_db_actor_guards.on_game_start — which NEVER RUNS ON A THIN CLIENT,
	-- and the thin client is exactly where the crash happens. Found by test_coop_meetdialog_live.sh reporting
	-- NOT MEASURED because the guard never announced itself in the client log. Installed explicitly here, like
	-- every other guard above.
	local okmd, errmd = pcall(function() zzz_mp_db_actor_guards.install_meet_dialog_guard() end)
	if not okmd then printf("! MP co-op: meet-dialog guard (client) failed: %s", tostring(errmd)) end

	-- THIN-CLIENT BINDERS: single-player object binders that look the object up in the
	-- A-Life simulator crash on a co-op client, which owns no A-Life (alife():object()
	-- returns nil), e.g. bind_heli.script:118 "attempt to index local 'se_obj' (a nil
	-- value)" on k00_marsh, which killed the client right after it entered the world.
	-- These world objects are server-owned in co-op and reach the client as replicated
	-- puppets, so the client-side binder logic is not needed — prevent it from binding.
	-- Each entry is {module, function}; missing ones are skipped. Add more as they surface.
	local binder_stubs = {
		{ "bind_heli", "bind" }, -- helicopters (Great Swamp etc.)
	}
	for _, s in ipairs(binder_stubs) do
		local mod_name, fn_name = s[1], s[2]
		local ok2 = pcall(function()
			local m = _G[mod_name]
			if m and m[fn_name] then
				m[fn_name] = function(...) return end
				printf("~ MP co-op: stubbed client-side %s.%s (thin client owns no A-Life)", mod_name, fn_name)
			end
		end)
		if not ok2 then printf("! MP co-op: binder stub failed for %s.%s", mod_name, fn_name) end
	end

	-- DIALOGUE PRECONDITIONS: these run on the CLIENT (the phrase list has to be built
	-- synchronously to draw the menu), and they read world state a thin client does not
	-- fully have, so some of them legitimately fail. That failure is NOT survivable in the
	-- engine: luabind calls its error callback from an UNPROTECTED call and expects it never
	-- to return, so continuing corrupts the VM (seen as an access violation in lj_vm_return
	-- from one single failing precondition). The only sound place to absorb it is here, on
	-- the Lua side, before the error ever reaches luabind.
	--
	-- Wrap each known-fragile precondition in pcall: a script that cannot answer now reads as
	-- "this phrase is not available", which is the sane result — the line is hidden instead of
	-- the session ending. Add entries as they surface; this is our overlay, no rebuild needed.
	local precondition_guards = {
		-- dialogs_axr_companion.script:363 — concatenates a nil giver_id when the hostage
		-- task cannot be resolved, which is the normal case on a client that owns no A-Life.
		{ "dialogs_axr_companion", "is_hostage_task_giver" },
	}
	for _, g in ipairs(precondition_guards) do
		local mod_name, fn_name = g[1], g[2]
		local ok3 = pcall(function()
			local m = _G[mod_name]
			if m and type(m[fn_name]) == "function" then
				local original = m[fn_name]
				m[fn_name] = function(...)
					local ok, result = pcall(original, ...)
					if ok then return result end
					return false
				end
				printf("~ MP co-op: guarded dialogue precondition %s.%s", mod_name, fn_name)
			end
		end)
		if not ok3 then printf("! MP co-op: precondition guard failed for %s.%s", mod_name, fn_name) end
	end

	-- CO-OP MARKER: an explicit, unambiguous flag other gamedata can test to know it is
	-- running on a co-op thin client (set here because on_client_level_start only runs on
	-- the co-op client, never in single-player).
	_G.mp_coop_client = true

	-- SAVE/LOAD (§9 design / §14 step 7): under Option B the SERVER owns and persists the
	-- one authoritative world (console `save` -> .scop). A thin client holds only a partial,
	-- replicated VIEW, so:
	--   * LOAD from a client is already inert — the client's save dir has no .scop, so the
	--     load list is empty (nothing to load). This is the intended state, not a bug.
	--   * SAVE from a client would write a misleading local .scop that, if ever loaded, spins
	--     up a DIVERGENT single-player world. Block it via the stock on_before_save_input hook
	--     (the same mechanism soulslike/hardcore-save modes use — see soulslike.script:511),
	--     with an on-screen message so it reads as "disabled by design", not "broken".
	-- Full co-op save/load (a server-authoritative world snapshot + client rejoin) is §14
	-- step 7 (deferred). NOTE: this blocks the manual menu Save; autosave paths that call the
	-- engine `save` directly are a separate step-7 concern (a thin client has little to persist).
	local oks, errs = pcall(function()
		local function coop_block_save(flags, typ, text)
			if not _G.mp_coop_client then return end -- never affects single-player
			-- Design doc §9.1: in co-op the save a player reaches for IS their checkpoint ("like choosing when to save
			-- in GAMMA"). The local save is still cancelled; the server is asked to bank a checkpoint where they stand,
			-- grants it at a campfire, and answers with a notice either way.
			local str = "Co-op: the server owns the world — local saving is disabled."
			local ok_req, sent = pcall(function() return level.coop_request_checkpoint and level.coop_request_checkpoint() end)
			if ok_req and sent then str = "Co-op: asking the server to set your checkpoint here..." end
			if actor_menu and actor_menu.set_msg then actor_menu.set_msg(1, str, 5) end
			exec_console_cmd("main_menu off")
			flags.ret = true -- cancel the save
		end
		RegisterScriptCallback("on_before_save_input", coop_block_save)
		printf("~ MP co-op: registered save-block (server owns saves; local save disabled)")
	end)
	if not oks then printf("! MP co-op: save-block register failed: %s", tostring(errs)) end

	-- §3c OPEN ITEM 5, LEG 5c: the SAVE path, which the §4.4.ii audit never exercised.
	-- Inert unless the sentinel file is present (see mp_coop_scenario_client_save.script), so
	-- every other client suite is untouched by this line. Guarded the same way vmwatch is, so a
	-- missing script cannot FATAL a client that never wanted the scenario.
	if mp_coop_scenario_client_save and mp_coop_scenario_client_save.attach then
		mp_coop_scenario_client_save.attach()
	end

	-- §3c OPEN ITEM 5, the CLIENT-ACTION axis (§4n). §4m showed xrServer::OnMessage is
	-- inbound-only — a server-driven world can never put a message on that wire, which is why
	-- driving a real A-Life boar around added nothing. The one axis left is what a CLIENT SENDS,
	-- so this drives inventory actions (M_EVENT) from the client's own actor. Same file-armed,
	-- absent-by-default mechanism as the save scenario above, and guarded the same way so a
	-- missing script cannot FATAL a client that never wanted it.
	if mp_coop_scenario_client_action and mp_coop_scenario_client_action.attach then
		mp_coop_scenario_client_action.attach()
	end

	-- §4t: the successor arm — a client action against an NPC's CSE (transfer_item ->
	-- GE_TRADE_SELL/GE_TRADE_BUY), which separates "any A-Life op on a script-wrapped CSE enters
	-- Lua" from "only a VIRTUAL dispatched through the wrapper does". Same file-armed,
	-- absent-by-default mechanism; its own sentinel so it cannot arm the §4n scenario or vice versa.
	if mp_coop_scenario_client_trade and mp_coop_scenario_client_trade.attach then
		mp_coop_scenario_client_trade.attach()
	end

	-- bug 3: put the client's actor beside idle NPCs so the walk-in-place verdict has subjects.
	-- File-armed and absent by default, like the three scenarios above.
	if mp_coop_scenario_client_goto and mp_coop_scenario_client_goto.attach then
		mp_coop_scenario_client_goto.attach()
	end

	-- design doc §10.1 test: try to skip time from the client; file-armed, absent by default.
	if mp_coop_scenario_client_timeskip and mp_coop_scenario_client_timeskip.attach then
		mp_coop_scenario_client_timeskip.attach()
	end

	-- design doc §9.1 test: one checkpoint request 40 s in; file-armed, absent by default.
	if mp_coop_scenario_client_cpreq and mp_coop_scenario_client_cpreq.attach then
		mp_coop_scenario_client_cpreq.attach()
	end

	-- design doc §13.1 test probe: logs mp_api every 10 s; file-armed, absent by default.
	if mp_coop_scenario_client_apiprobe and mp_coop_scenario_client_apiprobe.attach then
		mp_coop_scenario_client_apiprobe.attach()
	end
	if mp_coop_scenario_client_chat and mp_coop_scenario_client_chat.attach then
		mp_coop_scenario_client_chat.attach()
	end
	if mp_coop_scenario_client_take and mp_coop_scenario_client_take.attach then
		mp_coop_scenario_client_take.attach()
	end
	if mp_coop_scenario_client_s3 and mp_coop_scenario_client_s3.attach then
		pcall(mp_coop_scenario_client_s3.attach)   -- §10.3 S3 harness (armed by file only)
	end
	if mp_coop_scenario_client_buy and mp_coop_scenario_client_buy.attach then
		mp_coop_scenario_client_buy.attach()
	end

	-- (future thin-client globals get initialised here — one place, no engine
	--  rebuild needed to add more.)
end

-- MP fork (§14 co-op SERVER init): called ONCE by the engine (game_sv_Single::Create)
-- on the co-op dedicated server, after the A-Life simulator exists (script engine ready)
-- and BEFORE any on_game_load callback fires. The co-op server runs GAMMA's full
-- single-player + client script env, so scripts here reference globals that another mod's
-- client-only script is supposed to define. When that defining script never loads on a
-- headless -nosound server, the reference is nil and the game FATALs
-- ("attempt to call global (nil)"). Define server-safe fallbacks for those globals here.
--
-- Release-safe: this is our overlay only; no GAMMA mod is edited. Once the engine hook
-- exists, further server-side fixes are pure Lua here — no rebuild needed.
function on_server_game_start()
	-- DECISION REPLICATION (§4): self-check the server-side broadcast export. It reaches 0
	-- clients here (server init, pre-connect), but a clean COOP_DECISION_SV log with no Lua
	-- error proves the level.mp_broadcast_decision binding + hex decode work end to end. Real
	-- decision sites call it later with live online-NPC ids. Harmless on a normal run.
	-- NOTE: the export lives in the `game` luabind module (registered alongside mp_anchor_*),
	-- so the Lua path is game.mp_broadcast_decision, not level.*.
	local okb, errb = pcall(function()
		if game and game.mp_broadcast_decision then
			local n = game.mp_broadcast_decision(0xBEEF, 201, "cafe", 500)
			printf("~ MP co-op: decision export self-check -> %s real client(s)", tostring(n))
		else
			printf("! MP co-op: game.mp_broadcast_decision MISSING (old exe?)")
		end
	end)
	if not okb then printf("! MP co-op: decision export self-check errored: %s", tostring(errb)) end

	-- RPG LAYER (§14 step 8 phase 1 / doc §6): install the two-tier flag routing. Until this
	-- runs, every flag primitive on the server resolves through db.actor — which is nil here —
	-- so every world-gate read answers "no" and the world cannot progress. Server-only by
	-- construction: this hook does not exist on a client.
	local okf, errf = pcall(function() mp_coop_flags.install() end)
	if not okf then printf("! MP co-op: flag routing install errored: %s", tostring(errf)) end

	-- RPG LAYER (§14 step 8 phase 4 R2 / doc §8.1): the same treatment for reputation. Personal
	-- standing already rides the .scop per entity id (R1 measured it); what was missing is the
	-- subject, because every stock goodwill call site names db.actor:id(). Server-only, and a
	-- failed install leaves the stock bindings in place rather than a half-routed layer.
	local okr, errr = pcall(function() mp_coop_rep.install() end)
	if not okr then printf("! MP co-op: goodwill routing install errored: %s", tostring(errr)) end

	-- DECISION ORIGINATION (§4, first real online-NPC decision site): register the server-side
	-- per-frame originator. The engine (CLevel::coop_server_decision_tick, under -coop_server_tick)
	-- calls _G.mp_coop_server_tick(now_ms, real_count, actor_id) each frame; mp_coop_decision_server
	-- spawns a monster near a connected player and broadcasts KIND_MOVE decisions for it.
	local okt, errt = pcall(function()
		_G.mp_coop_server_tick = mp_coop_decision_server.tick
		printf("~ MP co-op: registered mp_coop_server_tick (decision origination)")
	end)
	if not okt then printf("! MP co-op: mp_coop_server_tick register failed: %s", tostring(errt)) end

	-- nextTick: canonically from Spatial Audio's kute_common.script (mod 469), which does
	-- not load on the -nosound server, so mods that call the bare global (e.g. mod 410's
	-- ubgl_no_3db.on_game_load) crash. Provide a fallback: defer via AddUniqueCall when
	-- available, else no-op — the deferred payloads are client visual effects (weapon anim
	-- show/hide) that are irrelevant on a renderless server. If kute_common ever does load,
	-- its `function nextTick` overrides this (we only fill a nil).
	if not nextTick then
		_G.nextTick = function(f, ...)
			if AddUniqueCall then
				local args = { ... }
				AddUniqueCall(function()
					f(unpack(args))
					return true
				end)
			end
		end
		printf("~ MP co-op: defined server-side nextTick fallback")
	end

	-- Math global aliases: many GAMMA client scripts (and their own nextTick fallbacks,
	-- e.g. G.A.M.M.A. Weapon Pack close_combat_weapons_launchers.script:39) call bare
	-- globals max/min/floor/ceil/abs that a core client script normally aliases to math.*.
	-- Those aren't defined on the headless server, so the calls hit nil. These are pure
	-- functions; aliasing them server-side is always safe. Only fill nils so anything that
	-- already defined them (client, or if a core script does load) wins.
	local math_aliases = { max = math.max, min = math.min, floor = math.floor,
	                       ceil = math.ceil, abs = math.abs }
	for name, fn in pairs(math_aliases) do
		if not _G[name] then _G[name] = fn end
	end

	-- AddUniqueCall: core deferred-call queue (normally from utils_obj/bind). If it is
	-- missing on the server, client scripts that queue visual effects through it crash.
	-- Provide a no-op fallback: the deferred payloads are client-side visuals, irrelevant
	-- on a renderless server. Only fill if nil (never override a real one).
	if not AddUniqueCall then
		_G.AddUniqueCall = function(f) return end
		printf("~ MP co-op: defined server-side AddUniqueCall no-op fallback")
	end

	-- SERVER PERF: GAMMA's per-NPC sound-scheme init (sound_theme.init_npc_sound, called
	-- from z_npc_footsteps for every A-Life NPC) tries to load voice/character sounds that
	-- don't exist on the -nosound headless server. Each miss raises a soft abort that logs a
	-- full Lua stack traceback, so loading the world took 10+ minutes and pegged a core.
	-- Sound is purely client-side (clients run their own sound), so stub it to a no-op on the
	-- server: NPC audio schemes aren't needed for authoritative A-Life/AI. Only override if
	-- present; leaves the client untouched (this hook is server-only).
	local ok_snd = pcall(function()
		if sound_theme and sound_theme.init_npc_sound then
			sound_theme.init_npc_sound = function(npc) return end
			printf("~ MP co-op: stubbed server-side sound_theme.init_npc_sound (-nosound perf)")
		end
	end)
	if not ok_snd then printf("! MP co-op: sound_theme stub failed") end

	-- NEW-GAME STARTING EQUIPMENT ON THE SERVER: itms_manager.actor_on_first_update arms
	-- CreateTimeEvent(0,"delay_new_game_autosave",4,new_game_equippment) whenever the
	-- "start_equippment_handled" info portion is absent — which it always is on the co-op
	-- server, whose actor is the loopback host stand-in rather than a freshly created
	-- character. new_game_equippment then runs `exec_console_cmd("save <user> - autosave")`,
	-- and the engine's console save writes a .dds THUMBNAIL via
	-- MainMenu()->Screenshot(SM_FOR_GAMESAVE, ...). On this renderless server the null-D3D9
	-- stub returns a success HRESULT with a NULL surface, so CRender::ScreenshotImpl derefs
	-- it and the whole server dies: 0xC0000005 accessing 0x0 at r__screenshot.cpp:259
	-- (symbolicated, RVA 0xD2C91C, build 30212914214). That is what blocked the P4 D0
	-- measurement for two sessions. Neither half of this belongs on a headless server that
	-- LOADS an existing world: it hands out a new character's kit and it writes a
	-- single-player save slot. Stub it. The engine keeps its own guard for any other save
	-- path (screenshot skipped when there is no renderer) — this is the no-rebuild half.
	local ok_nge = pcall(function()
		if itms_manager and itms_manager.new_game_equippment then
			itms_manager.new_game_equippment = function(...) return true end
			printf("~ MP co-op: stubbed server-side itms_manager.new_game_equippment (save-screenshot AV)")
		end
	end)
	if not ok_nge then printf("! MP co-op: new_game_equippment stub failed") end

	-- CLIENT-HUD SCRIPTS ON THE SERVER: GAMMA ships HUD/UI mods whose callbacks run through
	-- game_sv_single on the headless server, where there is no HUD (CurrentGameUI() is NULL),
	-- so they index nil and FATAL. They are purely visual, so no-op them server-side. Each
	-- entry is {module, function}; missing modules are skipped. Add new ones here as they
	-- surface — this is our overlay, so no engine rebuild is needed.
	local hud_stubs = {
		{ "factionid_hud_mcm", "activate_hud" }, -- factionid_hud_mcm.script:131 attempt to index nil
		-- actor_effects.HUD_mask (G.A.M.M.A. 3D PDA and Headlamp Animations) does
		-- `local hud = get_hud()` then indexes it; get_hud() is nil on the headless
		-- server, so it FATALs at actor_effects.script:1309 mid-session.
		{ "actor_effects", "HUD_mask" },
		-- Both of these do `get_hud():AddDialogToRender(...)` at level init, so they threw
		-- on the headless server, the co-op handler swallowed the error mid-callback, and
		-- the damaged LuaJIT VM crashed ~14 minutes later inside lj_tab_get — the crash that
		-- ended Caden's 2026-07-26 playtest (dev/SAVE_LOAD_PLAN.md §3c). Not visual polish:
		-- an unstubbed HUD script here is a delayed-action server crash.
		{ "axr_companions", "activate_hud" },  -- axr_companions.script:1839 attempt to index nil
		{ "ui_sidhud_mcm", "activate_hud" },   -- ui_sidhud_mcm.script:85 attempt to index nil
		-- The rest of the activate_hud/deactivate_hud FAMILY (§14 step 8 Q4, 2026-07-28). Two
		-- of these were found the expensive way — one crash each — so the remaining ones are
		-- taken from the list rather than waited for: `grep -l "^function activate_hud"` over
		-- the deployed scripts names exactly six modules, and every one of them does
		-- `get_hud():AddDialogToRender(...)`, which is nil here. Stubbing a HUD lifecycle
		-- function on a server with no HUD cannot lose anything.
		--
		-- actor_status.activate_hud (actor_status.script:266) is what killed the server on the
		-- first Q4 run that got past the dialogue: swallowed as error #1, and the damaged VM
		-- then FATALed in an unrelated namespace lookup — the same delayed mechanism as above.
		--
		-- Note the CASE. The module is `factionID_hud_mcm`, and the entry above spells it
		-- `factionid_hud_mcm`; Lua is case-sensitive and the namespace is the FILE name, so
		-- that older entry has never matched anything. Both spellings are listed, because
		-- removing the wrong one would be a guess about which file GAMMA ships next.
		{ "actor_status", "activate_hud" },
		{ "actor_status", "deactivate_hud" },
		{ "factionID_hud_mcm", "activate_hud" },
		{ "factionID_hud_mcm", "deactivate_hud" },
		{ "dynamic_emission_cover_mcm", "activate_hud" },
		{ "dynamic_emission_cover_mcm", "deactivate_hud" },
		{ "item_artefact", "activate_hud" },
		{ "item_artefact", "deactivate_hud" },
		{ "axr_companions", "deactivate_hud" },
		{ "ui_sidhud_mcm", "deactivate_hud" },
		-- news_manager (§14 step 8 phase 3 Q4, 2026-07-28). The PDA news feed: a sound, a
		-- translated caption, an icon and db.actor:give_talk_message2. All four are client
		-- things, and the server reaches all of them because news_manager.send_task is
		-- called from the TASK callbacks — so the moment a co-op player is GIVEN a task the
		-- headless server runs a UI function.
		--
		-- It has a `if db.actor == nil then return false end` guard and the guard did not
		-- save it, which is the part worth remembering: db.actor is NOT reliably nil on this
		-- server. A connected player's actor is a real object with a real binder here, so
		-- bind_stalker sets db.actor to it — meaning every "is there an actor?" guard in
		-- GAMMA answers YES on the server and then runs client code against whichever
		-- player's actor was bound last. Measured: monkey_news_manager.script:18
		-- "attempt to index local 'tsk' (a userdata value)" on a dialogue-routed claim,
		-- swallowed as error #1, followed by "error in error handling" and a FATAL — the
		-- same VM-corruption mechanism as the save-callback crash above.
		{ "news_manager", "send_task" },
		{ "news_manager", "send_tip" },
		{ "news_manager", "send_treasure" },
		{ "news_manager", "relocate_item" },   -- fires on a turn-in's item hand-over
		{ "news_manager", "relocate_money" },
	}
	for _, s in ipairs(hud_stubs) do
		local mod_name, fn_name = s[1], s[2]
		local ok = pcall(function()
			local m = _G[mod_name]
			if m and m[fn_name] then
				m[fn_name] = function(...) return end
				printf("~ MP co-op: stubbed server-side %s.%s", mod_name, fn_name)
			end
		end)
		if not ok then printf("! MP co-op: stub failed for %s.%s", mod_name, fn_name) end
	end

	-- §3c CHARACTERISATION (2026-07-28): arm the VM watcher if it is deployed. It samples
	-- LuaJIT's heap on the server tick so the long-run instability can be separated into
	-- "a swallowed error damaged the VM" and "the VM ran out of heap" — two hypotheses that fit
	-- the same symbolicated crashes and call for opposite fixes. Optional by design: a missing
	-- file is not an error, because this is a measuring instrument and not a dependency.
	pcall(function()
		if mp_coop_vmwatch and mp_coop_vmwatch.attach then mp_coop_vmwatch.attach() end
	end)

	-- §3c DELIBERATE REPRODUCTION (2026-07-28): publish the race bait if it is deployed. It does
	-- NOTHING on its own — the engine only calls it under -coop_repro_pumplua / -coop_repro_gamelua,
	-- which is what decides which THREAD enters the VM. Same optional-by-design rule as the
	-- watcher above: a missing file is not an error.
	pcall(function()
		if mp_coop_racebait and mp_coop_racebait.attach then mp_coop_racebait.attach() end
	end)

	-- WORLD-SAVE COMPLETENESS (§14 step 7): the server-authoritative autosave
	-- (game_sv_Single::coop_autosave) serializes the CSE/ALife world. During the save GAMMA
	-- per-object save-callbacks fire; hf_obj_manager.save_state iterates game_objects_iter(),
	-- a global the flat co-op gamedata never defines (its real definer wasn't flattened; blast
	-- radius is that one caller). The bare nil-call errors mid-save-callback, and the co-op
	-- continue-on-Lua-error handler swallows it in a way that corrupts the LuaJIT VM -> AV in
	-- lj_vm_return (crash symbolicated, build 30184076690/30184982768). Define a safe EMPTY
	-- iterator: the co-op server has no player hideout furniture, so save_state becomes a clean
	-- no-op. Only fill the nil (a real definer, if ever flattened, wins). See memory
	-- xray-coop-save-lua-callback-crash.
	if not game_objects_iter then
		_G.game_objects_iter = function() return function() return nil end end
		printf("~ MP co-op: defined server-side game_objects_iter fallback (empty; unblocks world autosave)")
	end
end
