--[[
	MP fork (§4 decision replication): client-side executor.

	When a scheduled server decision fires on this client's shared clock, the engine
	(CLevel::coop_dispatch_due_decisions) calls _G.mp_coop_on_decision, which is wired to
	on_decision() below by mp_client.on_client_level_start (the co-op thin client's Lua
	init hook — on_game_start never runs on a thin client, so this is registered there).

	subject_id : u16  - the object the decision concerns (an online NPC's id)
	kind       : u8   - decision kind enum (see KIND_* below)
	hex_args   : str  - kind-specific args, hex-encoded (binary-safe over Lua strings)

	KIND_MOVE (the first real online-NPC decision site): args are a movement target point,
	encoded by the point codec below. We resolve subject_id -> the online puppet and drive it
	with the Spike-2 monster-movement order (walk_fwd + move_end); native local AI executes it.
	The SAME codec + KIND enum is used by the server originator (mp_coop_decision_server.script).
--]]

-- Decision kinds — must match the server originators.
KIND_MOVE     = 1   -- move an online NPC to a target point (args = encoded point)
KIND_COMBAT   = 2   -- set an online NPC's combat enemy (args = enemy object id, u16)
KIND_MOVE_OBJ = 3   -- move an online NPC toward a target OBJECT (args = target object id, u16) — a
                    -- dynamic "follow/regroup" decision: the target is re-resolved each decision, so
                    -- the subject tracks a moving object. Reuses the move-execution machine below.
KIND_FLEE     = 4   -- flee from a threat OBJECT (args = threat object id, u16): move AWAY from it. The
                    -- flee target is recomputed each decision from the current positions (a reachable
                    -- vertex FLEE_DIST away, opposite the threat), so the subject keeps evading.

-- §14 step 3 (inversion): flip a decision-driven NPC to client-local AI ONLY when the client was
-- launched with -coop_local_ai. Default OFF keeps the NPC a NET-driven puppet (the working move
-- demo), so the still-incomplete inversion (increment C: Remote monster physics self-integration)
-- cannot regress the default path. Resolved once.
local coop_local_ai = nil
local function local_ai_enabled()
	if coop_local_ai == nil then
		local cl = ""
		pcall(function() cl = command_line() or "" end)
		coop_local_ai = string.find(cl, "-coop_local_ai", 1, true) ~= nil
	end
	return coop_local_ai
end

-- ---- point codec (shared convention with the server) --------------------------------------
-- X-Ray's Lua is 5.1 (no string.pack), so encode each coordinate as a cm-scaled signed int32
-- (round(coord*100)) in big-endian bytes -> hex. cm precision is ample for a movement target
-- and stays well inside int32 for any level coordinate (~±1000 m). 3 coords = 12 bytes = 24 hex.

local function i32_to_hex(v)
	v = v % 4294967296                       -- two's-complement wrap into unsigned 32
	local b0 = math.floor(v / 16777216) % 256
	local b1 = math.floor(v / 65536) % 256
	local b2 = math.floor(v / 256) % 256
	local b3 = v % 256
	return string.format("%02x%02x%02x%02x", b0, b1, b2, b3)
end

local function hex_to_i32(hex, byte_off)     -- byte_off: 0-based
	local u = tonumber(string.sub(hex, byte_off * 2 + 1, byte_off * 2 + 8), 16)
	if u == nil then return 0 end
	if u >= 2147483648 then u = u - 4294967296 end
	return u
end

local function round_scaled(f)
	if f >= 0 then return math.floor(f * 100 + 0.5) end
	return math.ceil(f * 100 - 0.5)
end

-- module-level so the server script (which duplicates the same math) and tests can reference it
function encode_point(v)
	return i32_to_hex(round_scaled(v.x)) .. i32_to_hex(round_scaled(v.y)) .. i32_to_hex(round_scaled(v.z))
end

function decode_point(hex)
	return vector():set(hex_to_i32(hex, 0) / 100, hex_to_i32(hex, 4) / 100, hex_to_i32(hex, 8) / 100)
end

-- u16 codec (KIND_COMBAT args = a single object id): 2 bytes big-endian = 4 hex chars.
function encode_u16(v)
	v = v % 65536
	return string.format("%02x%02x", math.floor(v / 256) % 256, v % 256)
end

function decode_u16(hex)
	return tonumber(string.sub(hex, 1, 4), 16) or 0
end

local function dist_xz(a, b)
	local dx, dz = a.x - b.x, a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

-- X-Ray's printf only interpolates %s (not %d/%f); string.format (Lua 5.1) does all of them
-- correctly (proven by the Spike-2 CSV writer). Build the line, then hand printf a single %s.
local function logf(...) printf("%s", string.format(...)) end

-- m_fDistToEnd > 0 lets the monster's path builder arrest the walk near the destination
-- (base_monster_script bfAssignMovement: is_path_end); default -1 makes it over-walk the point.
local DIST_TO_END = 1.5
-- §14 step 3 (increment C1c): arrival hysteresis, mirroring mp_coop_decision_server. Re-issuing
-- move(walk_fwd) re-arms ACT_WALK_FWD each time and its root motion carries the NPC PAST the target
-- (the overshoot). So the walk is issued ONCE per target and its single arrested path runs; we
-- re-issue only on a new target, drift past REARM_M after arriving, or loss of script control.
local STOP_M  = 2.5    -- within this of target -> arrived: stop re-issuing so it settles
local REARM_M = 4.0    -- if it drifts past this after arriving -> re-path once
-- per-subject drive state: subject_id -> { tx,ty,tz, arrived, issued }
local drive_state = {}

local function valid_lvid(vid)
	return vid ~= nil and vid ~= 4294967295 and vid ~= 65535
end

-- KIND_FLEE: how far to probe for a flee vertex per decision.
local FLEE_DIST = 12
local FLEE_DIRS = {
	{ 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 },
	{ 0.7071, 0.7071 }, { -0.7071, 0.7071 }, { 0.7071, -0.7071 }, { -0.7071, -0.7071 },
}

-- Compute a flee target: sweep 8 compass directions from the subject (like the server's choose_target,
-- which is reliable — a single "directly away" probe often hits a blocked/off-mesh vertex and returns
-- a vertex on the WRONG side), and pick the reachable vertex that MAXIMISES distance from the threat.
-- Measuring the actual resulting positions makes this robust to any vertex_in_direction quirk. Falls
-- back to a raw offset directly away from the threat if no vertex resolves.
local function compute_flee_target(obj, threat_pos)
	local lvid = obj:level_vertex_id()
	local sp = obj:position()
	local best_pos, best_td = nil, -1
	for _, dd in ipairs(FLEE_DIRS) do
		local dir = vector():set(dd[1], 0, dd[2])
		local vid = nil
		pcall(function() vid = level.vertex_in_direction(lvid, dir, FLEE_DIST) end)
		if valid_lvid(vid) then
			local ok, pos = pcall(function() return level.vertex_position(vid) end)
			if ok and type(pos) == "userdata" then
				local td = dist_xz(pos, threat_pos)
				if td > best_td then best_td, best_pos = td, pos end
			end
		end
	end
	if best_pos then return best_pos end
	local dir = vector():set(sp.x - threat_pos.x, 0, sp.z - threat_pos.z)  -- directly away
	if dir:magnitude() < 0.01 then dir:set(1, 0, 0) else dir:normalize() end
	return vector():set(sp.x + dir.x * FLEE_DIST, sp.y, sp.z + dir.z * FLEE_DIST)
end

-- ---- executor ------------------------------------------------------------------------------

-- Drive an online puppet to a target with the proven monster-movement order (Spike 2: monsters
-- obey raw scripted movement; bipeds freeze — biped control is a separate sub-problem).
-- use_node: prefer the node-based ctor (exact path-end vertex, cleaner pin). On a retry after a
-- stall we pass false to fall back to the blind point ctor (a resolved vertex can be unpathable and
-- silently no-op the order — the blind ctor + DIST_TO_END is the C1b-proven path that always moved).
local function drive_move(obj, tgt, use_node)
	-- clamp to the puppet's nav mesh so the order isn't silently dropped for an off-mesh target
	local dest = tgt
	if not obj:accessible(tgt) then
		local r1, r2 = obj:accessible_nearest(tgt, vector())
		if type(r2) == "userdata" then dest = r2
		elseif type(r1) == "userdata" then dest = r1 end
	end
	-- Resolve the destination to a nav VERTEX so the node-based move ctor gives the path builder an
	-- exact path-end node (mirrors the server). Skipped on a stall retry (use_node=false).
	local vid = nil
	if use_node then
		pcall(function() vid = level.vertex_id(vector():set(dest.x, dest.y, dest.z)) end)
	end
	-- Take script control ONCE. Calling obj:script(true) while already scripted raises
	-- "Invalid sequence of taking an entity under script control" (mirror the Spike-2 driver:
	-- only (re)take control when the engine reports the object is not currently scripted).
	if obj:get_script() == false then
		obj:script(true, "mp_coop_decision_client")
		obj:enable_vision(false)           -- no enemies -> combat won't override the move (Spike 2)
	end
	local a = entity_action()
	if valid_lvid(vid) then
		a:set_action(move(move.walk_fwd, vid, vector():set(dest.x, dest.y, dest.z), DIST_TO_END))
	else
		a:set_action(move(move.walk_fwd, vector():set(dest.x, dest.y, dest.z), DIST_TO_END))
	end
	a:set_action(cond(cond.move_end))
	obj:reset_action_queue()               -- command() APPENDS; reset so re-issues don't pile up
	obj:command(a, false)
end

-- §14 step 3: flip a decision-driven NPC to client-local AI (increment B). The engine gate
-- (CustomMonster.cpp: coop_puppet && !m_coop_locally_driven, and the Remote AI branch) then makes the
-- client run its native Think/ProcessScripts/Exec_Action LOCALLY — it executes the replicated order
-- itself instead of mirroring the streamed position. Per-NPC; normal puppets keep dense streaming.
local function flip_locally_driven(subject_id, obj)
	if not local_ai_enabled() then return end
	local sok, serr = pcall(function()
		obj:coop_set_locally_driven(true)
		logf("MP_COOP_LOCALAI: [CLIENT] subject=%s coop_set_locally_driven(true) OK; readback=%s",
			tostring(subject_id), tostring(obj:coop_locally_driven()))
	end)
	if not sok then
		logf("MP_COOP_LOCALAI: [CLIENT] subject=%s setter FAILED (binding missing?): %s",
			tostring(subject_id), tostring(serr))
	end
end

-- Shared move executor: flip to local AI, log the distance track, and drive the subject to a world
-- point with issue-once + arrival hysteresis + stall-retry. Used by both KIND_MOVE (fixed point) and
-- KIND_MOVE_OBJ (a target object's current position). tgt is a world vector.
--
-- §14 step 3 (increment C1c): the server re-broadcasts the same target every ~3s; re-issuing the walk
-- each time re-arms ACT_WALK_FWD and overshoots, so DON'T re-issue while the NPC is making progress.
-- But issue-once alone can FREEZE the NPC (the first order can land before the object is path-ready and
-- silently no-op, with no retry), so also re-issue when it has STALLED (no progress since the last
-- decision) or lost script control — while it is closing the gap we stay hands-off (no overshoot).
local function execute_move(subject_id, obj, tgt)
	flip_locally_driven(subject_id, obj)

	-- Sample position vs target FIRST so verification has a distance track on every decision.
	local p0 = obj:position()
	local d  = dist_xz(p0, tgt)
	logf("MP_COOP_MOVE: [CLIENT] subject=%s tgt=%.2f,%.2f,%.2f pos=%.2f,%.2f,%.2f dist=%.2f",
		tostring(subject_id), tgt.x, tgt.y, tgt.z, p0.x, p0.y, p0.z, d)

	local s = drive_state[subject_id]
	if not s or dist_xz(vector():set(s.tx, s.ty, s.tz), tgt) > 0.5 then
		s = { tx = tgt.x, ty = tgt.y, tz = tgt.z, arrived = false, issued = false, last_d = nil }
		drive_state[subject_id] = s
	end
	if s.arrived and d > REARM_M then s.arrived = false; s.issued = false end
	if (not s.arrived) and d <= STOP_M then
		s.arrived = true
		logf("MP_COOP_MOVE: [CLIENT] subject=%s ARRIVED (dist %.2f <= %.1f) — settling",
			tostring(subject_id), d, STOP_M)
	end
	if obj:get_script() == false then s.issued = false end  -- a scheme/binder reclaimed control: re-path

	local progressing = (s.last_d ~= nil) and (d < s.last_d - 0.3)
	local stalled     = (s.last_d ~= nil) and (d >= s.last_d - 0.3)
	if (not s.arrived) and ((not s.issued) or stalled) and (not progressing) then
		-- first issue prefers the node ctor (clean pin); a stall retry falls back to the blind point
		-- ctor (self-heals an unpathable resolved vertex).
		local use_node = (not s.issued)
		local ok, err = pcall(drive_move, obj, tgt, use_node)
		if ok then s.issued = true
		else
			logf("MP_COOP_MOVE: [CLIENT] subject=%s local drive order failed (puppet not controllable?): %s",
				tostring(subject_id), tostring(err))
		end
	end
	s.last_d = d
end

function on_decision(subject_id, kind, hex_args)
	if kind == KIND_MOVE then
		local tgt = decode_point(hex_args)
		local obj = level.object_by_id(subject_id)
		if not obj then
			-- subject isn't online on this client (outside the actor's online radius): degrade
			-- gracefully — the puppet will pick the target up if/when it net_Spawns.
			logf("MP_COOP_MOVE: [CLIENT] subject=%s NOT online here; tgt=%.2f,%.2f,%.2f",
				tostring(subject_id), tgt.x, tgt.y, tgt.z)
			return
		end
		execute_move(subject_id, obj, tgt)
		return
	end

	if kind == KIND_MOVE_OBJ then
		-- Move the subject toward a target OBJECT (by id) — a dynamic follow/regroup decision. The
		-- target position is re-resolved each decision, so the subject tracks a moving object; the
		-- move-execution machine treats a >0.5m target shift as a new target and re-paths.
		local target_id = decode_u16(hex_args)
		local obj  = level.object_by_id(subject_id)
		local tobj = level.object_by_id(target_id)
		if not obj or not tobj then
			logf("MP_COOP_MOVEOBJ: [CLIENT] subject=%s target=%s NOT both online (subj=%s tgt=%s)",
				tostring(subject_id), tostring(target_id), tostring(obj ~= nil), tostring(tobj ~= nil))
			return
		end
		local tgt = tobj:position()
		logf("MP_COOP_MOVEOBJ: [CLIENT] subject=%s target=%s target_pos=%.2f,%.2f,%.2f",
			tostring(subject_id), tostring(target_id), tgt.x, tgt.y, tgt.z)
		execute_move(subject_id, obj, tgt)
		return
	end

	if kind == KIND_FLEE then
		-- Flee from a threat OBJECT: move AWAY from it. The flee target is recomputed each decision
		-- from the CURRENT positions (a reachable vertex FLEE_DIST opposite the threat), so as the
		-- subject retreats the target keeps moving further away and it keeps evading — the shared
		-- execute_move sees a >0.5m target shift each decision and re-paths (no false "arrival").
		local threat_id = decode_u16(hex_args)
		local obj    = level.object_by_id(subject_id)
		local threat = level.object_by_id(threat_id)
		if not obj or not threat then
			logf("MP_COOP_FLEE: [CLIENT] subject=%s threat=%s NOT both online (subj=%s threat=%s)",
				tostring(subject_id), tostring(threat_id), tostring(obj ~= nil), tostring(threat ~= nil))
			return
		end
		local sp = obj:position()
		local tp = threat:position()
		local tgt = compute_flee_target(obj, tp)
		logf("MP_COOP_FLEE: [CLIENT] subject=%s threat=%s threat_dist=%.2f flee_to=%.2f,%.2f,%.2f (flee_to_threat=%.2f)",
			tostring(subject_id), tostring(threat_id), dist_xz(sp, tp), tgt.x, tgt.y, tgt.z, dist_xz(tgt, tp))
		execute_move(subject_id, obj, tgt)
		return
	end

	if kind == KIND_COMBAT then
		-- The server decided this online NPC's combat enemy. Apply it on the client's replicated copy.
		-- §4C PROVEN: a MONSTER given set_enemy (-> CBaseMonster::SetEnemy -> EnemyMan.script_enemy,
		-- perception/team-bypass — relaxed to all monsters) and NOT under script control self-drives
		-- combat via StateMan. The enemy must be RE-APPLIED each decision: a one-shot at spawn is
		-- dropped because EnemyMan.update() clears it while the target is momentarily !g_Alive. We do NOT
		-- take obj:script(true) (that would suppress Think/StateMan). NB the co-op server stays
		-- authoritative on outcomes (hp/death stream via M_UPDATE); the client copy's own combat is a
		-- consistency/liveness bonus. (Stalker fallback: set_relation — a logic-less stalker still won't
		-- fight, per the diagnosis.) monster_enemy() is the CORRECT engagement probe; best_enemy() is the
		-- stalker manager and is always nil for a monster.
		local enemy_id = decode_u16(hex_args)
		local npc = level.object_by_id(subject_id)
		local enemy = level.object_by_id(enemy_id)
		if not npc or not enemy then
			logf("MP_COOP_CB: [CLIENT] subject=%s enemy=%s NOT both online (npc=%s enemy=%s)",
				tostring(subject_id), tostring(enemy_id), tostring(npc ~= nil), tostring(enemy ~= nil))
			return
		end
		-- §4C client-LOCAL combat (the inversion payoff): under -coop_local_ai, flip the subject to
		-- locally-driven so shedule_Update runs Think()->StateMan on the CLIENT (it is NOT script-
		-- controlled -> Think, not ProcessScripts), and its EnemyMan.update() reflects the forced enemy
		-- -> the client's copy FIGHTS locally from the decision instead of only mirroring the server
		-- stream. The ~1s KIND_COMBAT re-broadcast refreshes the locally-driven TTL. The server stays
		-- authoritative on DEATH: health streams via net_Import regardless of locally-driven. Without
		-- -coop_local_ai this is a no-op and the client stays a streamed puppet (server-authoritative).
		flip_locally_driven(subject_id, npc)
		pcall(function() npc:set_enemy(enemy) end)                         -- monster (all CBaseMonster now)
		pcall(function()                                                   -- stalker fallback (InventoryOwner)
			npc:set_relation(game_object.enemy, enemy)
			npc:force_set_goodwill(-3000, enemy)
		end)
		local me = select(2, pcall(function() return npc:monster_enemy() end))
		logf("MP_COOP_CB: [CLIENT] subject=%s enemy=%s monster_enemy=%s hp=%.2f scripted=%s",
			tostring(subject_id), tostring(enemy_id),
			(type(me) == "userdata") and tostring(me:id()) or "nil", npc.health, tostring(npc:get_script()))
		return
	end

	printf("MP_COOP_DECISION_LUA: fired subject=%s kind=%s args=%s",
		tostring(subject_id), tostring(kind), tostring(hex_args))
end
