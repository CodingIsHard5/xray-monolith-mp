--[[
	MP fork (§4 decision replication): SERVER-side decision originator — the first REAL
	online-NPC decision site, driven entirely from gamedata through the mp_api seam.

	The engine calls _G.mp_coop_server_tick(now_ms, real_count, actor_id) each frame on the
	co-op host/server (CLevel::coop_server_decision_tick, gated behind -coop_server_tick).
	_G.mp_coop_server_tick is wired to tick() below by mp_client.on_server_game_start.

	What this does (first hook, deliberately a monster — Spike 2: monsters obey scripted
	movement, bipeds freeze):
	  1. Once a real remote player is connected, spawn one controllable monster next to that
	     player's actor (so it net_Spawns to the client, i.e. is online on BOTH ends).
	  2. Choose a movement target near the actor and, every BCAST_PERIOD, originate the decision:
	     game.mp_broadcast_decision(monster_id, KIND_MOVE, encode_point(target), LEAD).
	  3. Apply the SAME move to the server's authoritative monster so server and client run the
	     identical order and converge on the target (Spike-2 drift budget bounds the difference).

	The client's mp_coop_decision_client.on_decision resolves monster_id -> puppet and drives it.
	This is the payoff of §4: server decides an online NPC's movement, the client executes it.
--]]

local KIND_MOVE = mp_coop_decision_client.KIND_MOVE   -- = 1 (shared enum)

-- Prefer a docile flesh (the Spike-2 driver used a flesh and it followed orders cleanly). Dogs
-- are pack hunters and reassert native behaviour more aggressively.
local MONSTER_SECTIONS = {
	"flesh_normal", "flesh_03a_normal", "flesh_strong",
	"boar_normal", "dog_normal", "dog_strong",
}

local SPAWN_SIDE      = 6      -- m: spawn the monster this far to the actor's side
local TARGET_DIST     = 10     -- m: target this far from the monster in the first accessible dir
local LEAD_MS         = 500    -- scheduled-execution lead (well over LAN ping)
local BCAST_PERIOD_MS = 3000   -- re-broadcast the decision this often WHILE the NPC is still moving
local DIST_TO_END     = 1.5    -- m: path arrests within this of the destination (m_fDistToEnd > 0
                               -- enables the is_path_end completion; default -1 never arrests)
local STOP_M          = 2.5    -- arrived: stop commanding so the monster settles (idle, not re-walked)
local REARM_M         = 4.0    -- if it drifts past this after arriving, resume driving/broadcasting
local ONLINE_TIMEOUT  = 20000  -- ms after spawn to give up waiting for the monster to go online

local st = {
	phase       = "wait",   -- wait -> spawning -> wait_online -> active -> failed
	monster_id  = nil,
	spawn_ms    = nil,
	target      = nil,
	last_bcast  = 0,
	broadcasts  = 0,
}

-- X-Ray's printf only interpolates %s; string.format (Lua 5.1) handles %d/%f. Build then print.
local function logf(...) printf("%s", string.format(...)) end

local function pick_section()
	for _, s in ipairs(MONSTER_SECTIONS) do
		if system_ini():section_exist(s) then return s end
	end
	return nil
end

local function dist_xz(a, b)
	local dx, dz = a.x - b.x, a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

-- Pick a target that is an ACTUAL nav vertex, so the monster's path ENDS exactly there. A blind
-- "N metres east" world point can (a) land inside a Cordon structure and (b) sit up to several
-- metres off the nav mesh, so the path ends at the nearest vertex ~4 m away, the monster reaches
-- THAT and completes, then wanders (the plateau-at-4m overshoot we measured). level.vertex_in_
-- direction walks the graph from the monster's own vertex toward each compass heading and returns
-- a reachable vertex; we take the one that gives the most travel. Returns level_vertex_id, position.
local DIRS = {
	{ 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 },
	{ 0.7071, 0.7071 }, { -0.7071, 0.7071 }, { 0.7071, -0.7071 }, { -0.7071, -0.7071 },
}
local function valid_lvid(vid)
	return vid ~= nil and vid ~= 4294967295 and vid ~= 65535
end
local function choose_target(obj)
	local lvid0 = obj:level_vertex_id()
	local p = obj:position()
	local best_vid, best_pos, best_d = nil, nil, 0
	for _, dd in ipairs(DIRS) do
		local dir = vector():set(dd[1], 0, dd[2])
		local vid = level.vertex_in_direction(lvid0, dir, TARGET_DIST)
		if valid_lvid(vid) then
			local pos = level.vertex_position(vid)
			local d = dist_xz(p, pos)
			if d > best_d then best_d, best_vid, best_pos = d, vid, pos end
		end
	end
	if best_vid then return best_vid, best_pos end
	return lvid0, p   -- degenerate: boxed in, no meaningful move
end

-- same monster-movement order the client executor uses (Spike 2). Take script control ONCE:
-- obj:script(true) while already scripted raises "Invalid sequence of taking an entity under
-- script control", so (re)take only when the engine reports the object is not scripted.
-- dist_to_end > 0 lets the path builder ARREST the walk near the destination (base_monster_script
-- bfAssignMovement: is_path_end(m_fDistToEnd)); default -1 disables it and the monster over-walks.
local function drive_move(obj, vid, pos)
	if obj:get_script() == false then
		obj:script(true, "mp_coop_decision_server")
		obj:enable_vision(false)
	end
	local a = entity_action()
	-- node-based ctor move(walk_fwd, level_vertex_id, position, dist_to_end): gives the path builder
	-- an explicit destination NODE (exact path end) plus the arrest distance.
	a:set_action(move(move.walk_fwd, vid, vector():set(pos.x, pos.y, pos.z), DIST_TO_END))
	a:set_action(cond(cond.move_end))
	obj:reset_action_queue()
	obj:command(a, false)
end

local function do_spawn(actor)
	local apos = actor:position()
	local adir = actor:direction()
	local d = vector():set(adir.x, 0, adir.z)
	if d:magnitude() < 0.01 then d:set(1, 0, 0) else d:normalize() end   -- actor facing straight up/down
	local perp = vector():set(-d.z, 0, d.x)
	local section = pick_section()
	if not section then
		logf("! MP_COOP_SV: no monster section available; cannot originate move decision")
		st.phase = "failed"
		return
	end
	local spos = vector():set(apos.x + perp.x * SPAWN_SIDE, apos.y, apos.z + perp.z * SPAWN_SIDE)
	local ok, se = pcall(function()
		return alife():create(section, spos, actor:level_vertex_id(), actor:game_vertex_id())
	end)
	if not ok or not se then
		logf("! MP_COOP_SV: alife():create(%s) failed: %s", tostring(section), tostring(se))
		st.phase = "failed"
		return
	end
	st.monster_id = se.id
	st.spawn_ms   = time_global()
	st.phase      = "wait_online"
	-- target is chosen once the monster is online (needs the live object for accessibility tests)
	logf("~ MP_COOP_SV: spawned %s id=%d at %.2f,%.2f,%.2f",
		section, st.monster_id, spos.x, spos.y, spos.z)
end

local function tick_impl(now_ms, real_count, actor_id)
	if st.phase == "failed" then return end

	if st.phase == "wait" then
		if real_count < 1 or not actor_id or actor_id == 0 then return end
		local actor = level.object_by_id(actor_id)
		if not actor then return end
		st.phase = "spawning"
		do_spawn(actor)
		return
	end

	if st.phase == "wait_online" then
		local obj = level.object_by_id(st.monster_id)
		if obj then
			st.target_vid, st.target = choose_target(obj)
			st.need_issue = true
			st.phase  = "active"
			logf("~ MP_COOP_SV: monster id=%d online; target vertex %d @ %.2f,%.2f,%.2f (dist %.2f)",
				st.monster_id, st.target_vid, st.target.x, st.target.y, st.target.z,
				dist_xz(obj:position(), st.target))
		elseif time_global() - (st.spawn_ms or 0) > ONLINE_TIMEOUT then
			logf("! MP_COOP_SV: monster id=%s never came online within %dms; giving up",
				tostring(st.monster_id), ONLINE_TIMEOUT)
			st.phase = "failed"
		end
		return
	end

	if st.phase == "active" then
		local obj = level.object_by_id(st.monster_id)
		if not obj then return end   -- transient; wait for it to come back

		-- Recapture (cheap, every tick): a Cordon monster's own scheme/binder can pull script
		-- control back, after which it wanders. Re-assert whenever the engine reports it unscripted.
		if obj:get_script() == false then
			local rok = pcall(function() obj:script(true, "mp_coop_decision_server"); obj:enable_vision(false) end)
			st.recaptures = (st.recaptures or 0) + 1
			if not rok then st.ctrl_fail = (st.ctrl_fail or 0) + 1 end
			st.need_issue = true   -- lost control: it will have moved; re-path
			st.arrived    = false
		end

		local d = dist_xz(obj:position(), st.target)

		-- Arrival hysteresis. Once WITHIN STOP_M, stop re-issuing: re-issuing move(walk_fwd) re-arms
		-- ACT_WALK_FWD each time and its root motion carries the monster PAST the target (the overshoot
		-- we measured). If it drifts back past REARM_M, re-path once. The order is otherwise issued
		-- ONCE and the single path (to an exact nav vertex, arrested by dist_to_end) runs to completion.
		if st.arrived and d > REARM_M then st.arrived = false; st.need_issue = true end
		if not st.arrived and d <= STOP_M then
			st.arrived = true
			logf("~ MP_COOP_SV: subject=%d ARRIVED (dist %.2f <= %.1f) — settling", st.monster_id, d, STOP_M)
		end

		if not st.arrived and st.need_issue then
			st.need_issue = false
			local dok, derr = pcall(drive_move, obj, st.target_vid, st.target)
			if not dok and not st.drive_logged then
				st.drive_logged = true
				logf("! MP_COOP_SV: drive_move failed for subject=%d: %s", st.monster_id, tostring(derr))
			end
		end

		-- Re-broadcast the "go to target" decision on the 3s cadence regardless of arrival. In
		-- production decisions are rare (fire once); here we keep re-sending so the client keeps
		-- emitting position samples AFTER the server monster settles — that's how the harness
		-- confirms it stays pinned. Re-sending is idempotent (same target); the client re-arms its
		-- own walk toward an already-reached point, which M_UPDATE holds in place. wrap-safe u32 diff.
		local elapsed = now_ms - st.last_bcast
		if elapsed < 0 then elapsed = elapsed + 4294967296 end
		if elapsed < BCAST_PERIOD_MS then return end
		st.last_bcast = now_ms

		local hex = mp_coop_decision_client.encode_point(st.target)
		local n = 0
		local ok, berr = pcall(function()
			n = game.mp_broadcast_decision(st.monster_id, KIND_MOVE, hex, LEAD_MS) or 0
		end)
		if not ok then
			logf("! MP_COOP_SV: broadcast FAILED for subject=%d: %s", st.monster_id, tostring(berr))
		end
		st.broadcasts = st.broadcasts + 1
		local p = obj:position()
		logf("~ MP_COOP_SV: broadcast #%d subject=%d -> %d client(s); monster %.2f,%.2f,%.2f dist=%.2f scripted=%s recap=%d",
			st.broadcasts, st.monster_id, n, p.x, p.y, p.z, d, tostring(obj:get_script()), st.recaptures or 0)
	end
end

-- _G.mp_coop_server_tick target (registered in mp_client.on_server_game_start). Dispatches to a
-- scenario chosen ONCE from the engine command line: -coop_combat -> the KIND_COMBAT originator
-- (mp_coop_scenario_combat), otherwise the default KIND_MOVE originator (this file). Lets one
-- engine hook drive different decision sites without a rebuild (command_line() = Core.Params).
local scenario = nil   -- nil until resolved; then "move" or a delegate function
function tick(now_ms, real_count, actor_id)
	if scenario == nil then
		local cl = ""
		pcall(function() cl = command_line() or "" end)
		if string.find(cl, "-coop_combat", 1, true) then
			scenario = mp_coop_scenario_combat.tick
			logf("~ MP_COOP_SV: scenario = COMBAT (mp_coop_scenario_combat)")
		else
			scenario = "move"
			logf("~ MP_COOP_SV: scenario = MOVE (default)")
		end
	end
	if scenario ~= "move" then
		-- the delegate guards itself, but wrap anyway so a nil/broken scenario can't propagate a
		-- Lua error up through the engine functor call; latch it off after the first failure.
		local ok, err = pcall(scenario, now_ms, real_count, actor_id)
		if not ok then
			logf("! MP_COOP_SV scenario error: %s", tostring(err))
			scenario = function() end   -- stop retrying a broken scenario
		end
		return
	end
	local ok, err = pcall(tick_impl, now_ms, real_count, actor_id)
	if not ok then
		logf("! MP_COOP_SV tick error: %s", tostring(err))
		st.phase = "failed"
	end
end
