--[[
	MP fork (§4C): SERVER-side COMBAT decision originator — the second real online-NPC decision
	site (KIND_COMBAT), driven from gamedata through the mp_api seam. Selected by
	mp_coop_decision_server.tick when command_line() contains -coop_combat.

	The decision is "attacker A's enemy is target B". This uses two STALKERS and the general
	`set_relation(game_object.enemy, ...)` lever (InventoryOwner-only), because the concrete,
	VERIFIABLE state change is the relation registry: after the client applies the decision, its
	`A:relation(B)` reads back as enemy — proving the seam executed the decision on the client, not
	just delivered it.

	What this proves: the mp_api seam carries a SECOND decision kind (a u16 enemy id, distinct from
	KIND_MOVE's point codec); the server originates it via game.mp_broadcast_decision; it reaches the
	real client; and the client resolves BOTH real NPCs (subject + enemy) and applies the identical
	hostile relation.

	KNOWN GAP (documented, not solved here): native combat ENGAGEMENT — the NPCs actually FIGHTING
	(best_enemy populated) — does NOT fire for freshly-spawned, logic-less NPCs on the headless
	server (tested: stalker set_relation and bloodsucker set_enemy both leave best_enemy nil and the
	pair wanders apart). That is the NPC-combat-AI-liveness sub-problem (active scheme / perception on
	the dedicated server), tracked separately. See dev/DECISION_REPLICATION_PLAN.md.
--]]

local KIND_COMBAT = mp_coop_decision_client.KIND_COMBAT   -- = 2 (shared enum)

local ATTACKER_SECTIONS = { "sim_default_bandit_1", "sim_default_bandit_0", "sim_default_bandit_2", "default_bandit" }
local TARGET_SECTIONS   = { "sim_default_military_1", "sim_default_military_0", "sim_default_military_2", "default_duty" }

local SPAWN_SIDE      = 8      -- m: spawn the pair this far to the actor's side
local PAIR_GAP        = 7      -- m: distance between attacker and target
local LEAD_MS         = 500
local BCAST_PERIOD_MS = 3000
local ONLINE_TIMEOUT  = 25000

local st = {
	phase = "wait", a_id = nil, b_id = nil, spawn_ms = nil,
	last_bcast = 0, broadcasts = 0, applied = false,
}

local function logf(...) printf("%s", string.format(...)) end

local function pick_section(cands)
	for _, s in ipairs(cands) do
		if system_ini():section_exist(s) then return s end
	end
	return nil
end

local function spawn_one(section, pos, actor)
	local ok, se = pcall(function()
		return alife():create(section, pos, actor:level_vertex_id(), actor:game_vertex_id())
	end)
	if ok and se then return se.id end
	logf("! MP_COOP_CB: alife():create(%s) failed: %s", tostring(section), tostring(se))
	return nil
end

local function do_spawn(actor)
	local apos = actor:position()
	local adir = actor:direction()
	local d = vector():set(adir.x, 0, adir.z)
	if d:magnitude() < 0.01 then d:set(1, 0, 0) else d:normalize() end   -- actor facing straight up/down
	local perp = vector():set(-d.z, 0, d.x)
	local asec = pick_section(ATTACKER_SECTIONS)
	local bsec = pick_section(TARGET_SECTIONS)
	if not asec or not bsec then
		logf("! MP_COOP_CB: no stalker sections (attacker=%s target=%s)", tostring(asec), tostring(bsec))
		st.phase = "failed"; return
	end
	local base = vector():set(apos.x + perp.x * SPAWN_SIDE, apos.y, apos.z + perp.z * SPAWN_SIDE)
	local apos_s = vector():set(base.x - d.x * PAIR_GAP * 0.5, base.y, base.z - d.z * PAIR_GAP * 0.5)
	local bpos_s = vector():set(base.x + d.x * PAIR_GAP * 0.5, base.y, base.z + d.z * PAIR_GAP * 0.5)
	st.a_id = spawn_one(asec, apos_s, actor)
	st.b_id = spawn_one(bsec, bpos_s, actor)
	if not st.a_id or not st.b_id then st.phase = "failed"; return end
	st.spawn_ms = time_global()
	st.phase = "wait_online"
	logf("~ MP_COOP_CB: spawned attacker %s id=%d + target %s id=%d (gap %dm)",
		asec, st.a_id, bsec, st.b_id, PAIR_GAP)
end

local function set_hostile(a, b)
	a:set_relation(game_object.enemy, b)
	b:set_relation(game_object.enemy, a)
	a:force_set_goodwill(-3000, b)
	b:force_set_goodwill(-3000, a)
end

local function best_enemy_id(obj)
	local be = obj:best_enemy()
	return be and be:id() or nil
end

local function relation_of(a, b)
	local ok, r = pcall(function() return a:relation(b) end)
	if ok then return r end
	return nil
end

local function tick_impl(now_ms, real_count, actor_id)
	if st.phase == "failed" then return end

	if st.phase == "wait" then
		if real_count < 1 or not actor_id or actor_id == 0 then return end
		local actor = level.object_by_id(actor_id)
		if not actor then return end
		st.phase = "spawning"
		do_spawn(actor)
		return
	end

	if st.phase == "wait_online" then
		local a = level.object_by_id(st.a_id)
		local b = level.object_by_id(st.b_id)
		if a and b then
			st.phase = "active"
			logf("~ MP_COOP_CB: both stalkers online (a=%d b=%d)", st.a_id, st.b_id)
		elseif time_global() - (st.spawn_ms or 0) > ONLINE_TIMEOUT then
			logf("! MP_COOP_CB: stalkers never both online (a=%s b=%s); giving up",
				tostring(level.object_by_id(st.a_id) ~= nil), tostring(level.object_by_id(st.b_id) ~= nil))
			st.phase = "failed"
		end
		return
	end

	if st.phase == "active" then
		local a = level.object_by_id(st.a_id)
		local b = level.object_by_id(st.b_id)
		if not a or not b then return end

		if not st.applied then
			local ok, err = pcall(set_hostile, a, b)
			st.applied = ok
			if not ok then logf("! MP_COOP_CB: server set_hostile failed: %s", tostring(err)) end
		end

		local elapsed = now_ms - st.last_bcast
		if elapsed < 0 then elapsed = elapsed + 4294967296 end
		if elapsed < BCAST_PERIOD_MS then return end
		st.last_bcast = now_ms

		local hex = mp_coop_decision_client.encode_u16(st.b_id)
		local n = 0
		local ok, berr = pcall(function()
			n = game.mp_broadcast_decision(st.a_id, KIND_COMBAT, hex, LEAD_MS) or 0
		end)
		if not ok then logf("! MP_COOP_CB: broadcast FAILED: %s", tostring(berr)) end
		st.broadcasts = st.broadcasts + 1
		logf("~ MP_COOP_CB: broadcast #%d subject=%d enemy=%d -> %d client(s); server A relation(B)=%s best_enemy=%s",
			st.broadcasts, st.a_id, st.b_id, n,
			tostring(relation_of(a, b)), tostring(best_enemy_id(a)))
	end
end

function tick(now_ms, real_count, actor_id)
	local ok, err = pcall(tick_impl, now_ms, real_count, actor_id)
	if not ok then
		logf("! MP_COOP_CB tick error: %s", tostring(err))
		st.phase = "failed"
	end
end
