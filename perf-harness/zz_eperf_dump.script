-- EnginePerf equivalence harness: A-Life state dump (test overlay only; lives in the project's run dir).
-- Inactive unless the engine was started with -det_mode.
--   -det_tag <name>  -det_interval <engine seconds>  -det_checkpoints <n>
-- Writes $logs$/alife_dump_<tag>_<k>.txt at each checkpoint, then quits after the last one.
local cl = command_line and command_line() or ""
local active = string.find(cl, "-det_mode", 1, true) ~= nil
local tag = string.match(cl, "%-det_tag%s+(%S+)") or "run"
local interval = (tonumber(string.match(cl, "%-det_interval%s+(%d+)")) or 60) * 1000
local total = tonumber(string.match(cl, "%-det_checkpoints%s+(%d+)")) or 3
local trace = tonumber(string.match(cl, "%-det_trace%s+(%d+)")) or 0 -- log generator states for the first N updates
-- -det_times a,b,c (engine seconds from the start point) replaces the even interval: checkpoint k at times[k]
local times = {}
for v in string.gmatch(string.match(cl, "%-det_times%s+(%S+)") or "", "%d+") do times[#times + 1] = tonumber(v) * 1000 end
if #times > 0 then total = #times end
-- -det_perturb skip|draw  [-det_perturb_at <engine seconds>, default 60]: CONTROL runs only (must-fail check).
--   skip: the first update of an OFFLINE squad after that time is skipped once (whole sim_squad_scripted:update)
--   draw: one extra math.random() call at that time (shifts the Lua random sequence by one draw)
local perturb = string.match(cl, "%-det_perturb%s+(%a+)")
local perturb_at = (tonumber(string.match(cl, "%-det_perturb_at%s+(%d+)")) or 60) * 1000
local perturbed = false
-- dose series (ruling 2026-11-19): -det_perturb skip -det_perturb_n <N> skips the first N offline squad updates after the time;
-- -det_perturb decision: one extra math.random() immediately before the first target choice (SIMBOARD:get_squad_target)
-- made for an OFFLINE squad after the time, i.e. a draw inside a squad decision path.
local perturb_n = tonumber(string.match(cl, "%-det_perturb_n%s+(%d+)")) or 1
local perturb_done = 0
local streams_on = string.find(cl, "-det_lua_streams", 1, true) ~= nil
local stream_sites = {}
-- -det_counters (tier (a) option A, ruling 2026-11-19): exact counters dumped at each checkpoint
local counters_on = string.find(cl, "-det_counters", 1, true) ~= nil
local stream_cnt, stream_hash, stream_seed = { alife = 0, weather = 0 }, { alife = 7, weather = 7 }, nil
local stream_draw = nil
-- -det_passes a,b,c: checkpoint k fires when the k-th listed number of A-Life scheduler passes (counted from the start
-- point) has run, instead of at a time. A pass = a frame in which a scheduled squad/smart script update ran.
-- world-process test (stage 0, 2026-11-19): -det_noonline keeps everything offline (switch distance 0.5 m, re-applied);
-- -det_noalife is its negative control (0 scheduled objects per pass, re-applied): A-Life must then look dead.
local noonline = string.find(cl, "-det_noonline", 1, true) ~= nil
local noalife = string.find(cl, "-det_noalife", 1, true) ~= nil
local pass_at = {}
for v in string.gmatch(string.match(cl, "%-det_passes%s+(%S+)") or "", "%d+") do pass_at[#pass_at + 1] = tonumber(v) end
if #pass_at > 0 then total = #pass_at end
local sq_cnt = {} -- [squad id] = { updates, target choices, action/target changes, member deaths }
local info_cnt = { register = 0, unregister = 0 }
local dosave = string.find(cl, "-det_save", 1, true) ~= nil
local quit_at = nil
local start_t, done, upd = nil, 0, 0
local pass_count, pass_last_upd = 0, -1
local function note_pass() if start_t and upd ~= pass_last_upd then pass_last_upd = upd pass_count = pass_count + 1 end end

local function g(f, ...) local ok, v = pcall(f, ...) if ok then return v end return nil end
local function s(v) if v == nil then return "-" end return tostring(v) end

local function dump(k)
	local path = getFS():update_path("$logs$", string.format("alife_dump_%s_%d.txt", tag, k))
	local f = io.open(path, "w")
	if not f then printf("! eperf dump: cannot open %s", path) return end
	local sim = alife()
	f:write(string.format("#checkpoint %d engine_ms %d game %s\n", k, time_global() - start_t, s(g(function() return game.get_game_time():diffSec(level.get_start_time()) end))))
	local n = 0
	for id = 0, 65534 do
		local se = sim:object(id)
		if se then
			n = n + 1
			local p = se.position
			local line = { id, se:section_name(), se:name(), se.parent_id, se.m_game_vertex_id, se.m_level_vertex_id,
				string.format("%.2f,%.2f,%.2f", p.x, p.y, p.z), s(se.online) }
			local alive = g(function() return se:alive() end)
			if alive ~= nil then
				line[#line + 1] = "alive=" .. s(alive)
				line[#line + 1] = "hp=" .. s(g(function() return string.format("%.3f", se:health()) end))
				line[#line + 1] = "comm=" .. s(g(function() return se:community() end))
				line[#line + 1] = "rank=" .. s(g(function() return se:rank() end))
				line[#line + 1] = "money=" .. s(g(function() return se:character_money() end))
				line[#line + 1] = "squad=" .. s(g(function() return se.group_id end))
			end
			if se.current_action ~= nil or se.assigned_target_id ~= nil or se.current_target_id ~= nil then
				line[#line + 1] = "sq_action=" .. s(g(function() return type(se.current_action) == "table" and se.current_action.name or se.current_action end))
				line[#line + 1] = "sq_target=" .. s(se.current_target_id) .. "/" .. s(se.assigned_target_id)
				line[#line + 1] = "sq_smart=" .. s(se.smart_id)
				line[#line + 1] = "sq_npcs=" .. s(g(function() return se:npc_count() end))
				line[#line + 1] = "sq_player=" .. s(se.player_id)
			end
			if se.npc_info ~= nil then
				local c = 0 for _ in pairs(se.npc_info) do c = c + 1 end
				line[#line + 1] = "smart_npcs=" .. c
				line[#line + 1] = "smart_pop=" .. s(se.population)
			end
			f:write(table.concat(line, "\t"), "\n")
		end
	end
	f:write("#objects " .. n .. "\n")
	-- faction relations
	local facs = g(function() return game_relations.factions_table end)
	if facs then
		for _, a in ipairs(facs) do
			local row = {}
			for _, b in ipairs(facs) do row[#row + 1] = s(g(function() return relation_registry.community_relation(a, b) end)) end
			f:write("#rel\t" .. a .. "\t" .. table.concat(row, ",") .. "\n")
		end
	end
	-- actor
	local cnt = 0
	g(function() db.actor:iterate_inventory(function() cnt = cnt + 1 end, db.actor) end)
	local ap = db.actor:position()
	f:write(string.format("#actor money=%s items=%d pos=%.2f,%.2f,%.2f hp=%.3f\n", s(g(function() return db.actor:money() end)), cnt, ap.x, ap.y, ap.z, db.actor.health))
	f:close()
	printf(string.format("* eperf dump: checkpoint %d written, %d objects", k, n))
end

local ltrace = {}
local function on_update()
	if not start_t then
		start_t = time_global()
		printf(string.format("* det_lua_state pre: %d", math.random(1, 1000000000))) -- Lua generator as loading left it
		get_console():execute("det_rng_state pre")
		get_console():execute("det_reseed")
		math.randomseed(12071980)
		get_console():execute("det_rng_state start")
		printf(string.format("* det_lua_state start: %d", math.random(1, 1000000000)))
		if trace > 0 then dump(0) end -- state at the reseed point: tells "started different" from "diverged later"
	end
	upd = upd + 1
	if noonline and (upd == 1 or upd % 100 == 0) then
		alife():set_switch_distance(0.5)
		if upd == 1 then printf("* det_noonline: switch distance set to 0.5 m") end
	end
	if noalife then
		alife():set_objects_per_update(0)
		if upd == 1 then printf("* det_noalife: objects per update set to 0") end
	end
	if perturb == "draw" and not perturbed and time_global() - start_t >= perturb_at then
		perturbed = true
		printf(string.format("* det_perturb draw: one extra math.random at update %d -> %d", upd, math.random(1, 1000000000)))
	end
	if perturb == "adraw" and not perturbed and stream_draw and time_global() - start_t >= perturb_at then
		perturbed = true
		printf(string.format("* det_perturb adraw: one extra draw on the alife stream at update %d -> %d", upd, stream_draw("alife", 1, 1000000000)))
	end
	if upd <= trace then -- full-precision positions of a few watched objects (ids from -det_watch a,b,c) and the camera
		local parts = {}
		local c = device().cam_pos
		parts[1] = string.format("cam %.9g %.9g %.9g", c.x, c.y, c.z)
		local a = db.actor:position()
		parts[2] = string.format("actor %.9g %.9g %.9g", a.x, a.y, a.z)
		for id in string.gmatch(string.match(cl, "%-det_watch%s+(%S+)") or "", "%d+") do
			local o = level.object_by_id(tonumber(id))
			if o then
				local q = o:position()
				parts[#parts + 1] = string.format("%s %.9g %.9g %.9g", id, q.x, q.y, q.z)
			end
		end
		printf("* det_pos u" .. upd .. ": " .. table.concat(parts, " | "))
	end
	if upd <= trace then
		get_console():execute("det_rng_state u" .. upd)
		printf(string.format("* det_lua_state u%d: %d", upd, math.random(1, 1000000000)))
	end
	local due
	if #pass_at > 0 then due = pass_count >= (pass_at[done + 1] or math.huge)
	else due = time_global() - start_t >= (times[done + 1] or (done + 1) * interval) end
	if done < total and due then
		done = done + 1
		get_console():execute("det_rng_state cp" .. done)
		printf(string.format("* det_lua_state cp%d: %d", done, math.random(1, 1000000000)))
		if done == 1 then
			get_console():execute("det_trace_dump " .. tag)
			local f = io.open(getFS():update_path("$logs$", "det_trace_" .. tag .. ".lua.txt"), "w")
			if f then f:write(table.concat(ltrace, "\n"), "\n") f:close() end
		end
		dump(done)
		if streams_on then
			local f = io.open(getFS():update_path("$logs$", "det_streams_" .. tag .. "_" .. done .. ".txt"), "w")
			if f then
				local keys = {}
				for k in pairs(stream_sites) do keys[#keys + 1] = k end
				table.sort(keys)
				for _, k in ipairs(keys) do f:write(k, " ", stream_sites[k], "\n") end
				f:close()
			end
		end
		if counters_on then
			get_console():execute("det_alife_counts " .. tag .. "_" .. done)
			local f = io.open(getFS():update_path("$logs$", "det_counters_" .. tag .. "_" .. done .. ".txt"), "w")
			if f then
				for _, gname in ipairs({ "alife", "weather" }) do
					f:write(string.format("stream %s %d %d %d\n", gname, stream_cnt[gname], stream_seed and stream_seed[gname] or 0, stream_hash[gname]))
				end
				local ids = {}
				for id in pairs(sq_cnt) do ids[#ids + 1] = id end
				table.sort(ids)
				local sim = alife()
				for _, id in ipairs(ids) do
					local r, o = sq_cnt[id], sim:object(id)
					f:write(string.format("sq %d %d %d %d %d %s\n", id, r[1], r[2], r[3], r[4], o and (o.online and "1" or "0") or "-"))
				end
				f:write("info passes ", pass_count, "\n", "info time_ms ", time_global() - start_t, "\n")
				f:write("info register ", info_cnt.register, "\n", "info unregister ", info_cnt.unregister, "\n")
				f:close()
			end
		end
		-- -det_save: also write a real game save at the checkpoint (into the project's own run dir). The command is
		-- issued at the same update in every run; quitting waits so the save is on disk first.
		if dosave then get_console():execute("save det_" .. tag .. "_" .. done) end
		if done >= total then quit_at = upd + (dosave and 120 or 0) end
		get_console():execute("flush")
	end
	-- keep the log on disk so a hard stop still leaves evidence (log only, no sim state)
	if upd % 300 == 0 then get_console():execute("flush") end
	if quit_at and upd >= quit_at then
		quit_at = nil
		get_console():execute("quit")
	end
end

-- ===== tier (b) NORMAL-MODE path (2026-11-20). Used only with -tb_dump and WITHOUT -det_mode; the det path above never
-- calls anything in this block. No reseed, no os.time/os.clock override, no RNG tracing, no det_* console commands.
--   -tb_dump -det_tag <t> -det_times a,b,c : alife_dump_<t>_<k>.txt (same format) + tb_extra_<t>_<k>.txt at the start point
--     (k=0) and at each listed engine time, quit after the last. Without -det_times: -det_interval/-det_checkpoints as above.
--   -tb_skip N [-tb_skip_at s, default 60]  : must-fail control, skip the first N OFFLINE squad updates after that time
--   -tb_walk s                              : every s engine seconds teleport the actor to the next smart terrain of its
--     level (route = that level's smart terrains sorted by id, cyclic, fixed per save)
local tb = not active and string.find(cl, "-tb_dump", 1, true) ~= nil
local tb_skip_n = tonumber(string.match(cl, "%-tb_skip%s+(%d+)")) or 0
local tb_skip_at = (tonumber(string.match(cl, "%-tb_skip_at%s+(%d+)")) or 60) * 1000
local tb_skip_done, tb_skip_first, tb_skip_last = 0, nil, nil
--   -tb_lostreg N [-tb_lostreg_at s, default 60] : must-fail control for statistic C (PREREG-tierB-statC): after a
--     normal OFFLINE squad update, unregister ONE member (whose smart is the squad's smart) from that smart via the
--     smart's own unregister_npc, N times in all; the squad keeps its smart_id (a lost registration, same work)
local tb_lr_n = tonumber(string.match(cl, "%-tb_lostreg%s+(%d+)")) or 0
local tb_lr_at = (tonumber(string.match(cl, "%-tb_lostreg_at%s+(%d+)")) or 60) * 1000
local tb_lr_done, tb_lr_first, tb_lr_last = 0, nil, nil
local tb_walk = tonumber(string.match(cl, "%-tb_walk%s+(%d+)"))
local tb_route, tb_step = nil, 0

local function tb_extra(k)
	local path = getFS():update_path("$logs$", string.format("tb_extra_%s_%d.txt", tag, k))
	local f = io.open(path, "w")
	if not f then printf(string.format("! tb_dump: cannot open %s", path)) return end
	local sim, gg = alife(), game_graph()
	local function lvl(gv) return s(g(function() return sim:level_name(gg:vertex(gv):level_id()) end)) end
	f:write(string.format("#tb_extra %d engine_ms %d upd %d\n", k, time_global() - start_t, upd))
	f:write("info passes ", pass_count, "\n", "info time_ms ", time_global() - start_t, "\n")
	f:write("info skip_n ", tb_skip_n, "\n", "info skip_done ", tb_skip_done, "\n", "info walk_step ", tb_step, "\n")
	f:write("info skip_at_ms ", tb_skip_at, "\n", "info skip_first_ms ", s(tb_skip_first), "\n", "info skip_last_ms ", s(tb_skip_last), "\n")
	f:write("info lostreg_n ", tb_lr_n, "\n", "info lostreg_done ", tb_lr_done, "\n", "info lostreg_first_ms ", s(tb_lr_first), "\n", "info lostreg_last_ms ", s(tb_lr_last), "\n")
	f:write("info actor_level ", s(g(function() return level.name() end)), "\n")
	-- sq <id> <section> <level> <game vertex> <smart id> <npc count>
	-- cr <id> <section> <kind stalker|monster|-> <alive 0|1> <level> <game vertex> <squad id> <smart id>
	-- sm <id> <name> <level> <assigned npc count>
	for id = 0, 65534 do
		local se = sim:object(id)
		if se then
			local gv = se.m_game_vertex_id
			local alive = g(function() return se:alive() end)
			if alive ~= nil then
				local c = g(function() return se:clsid() end)
				local kind = (c and g(function() return IsStalker(nil, c) end) and "stalker") or (c and g(function() return IsMonster(nil, c) end) and "monster") or "-"
				f:write(string.format("cr\t%d\t%s\t%s\t%d\t%s\t%s\t%s\t%s\n", id, se:section_name(), kind, alive and 1 or 0, lvl(gv), s(gv),
					s(se.group_id), s(se.m_smart_terrain_id)))
			end
			if se.current_action ~= nil or se.assigned_target_id ~= nil or se.current_target_id ~= nil then
				f:write(string.format("sq\t%d\t%s\t%s\t%s\t%s\t%s\n", id, se:section_name(), lvl(gv), s(gv), s(se.smart_id),
					s(g(function() return se:npc_count() end))))
			end
			if se.npc_info ~= nil then
				local c = 0 for _ in pairs(se.npc_info) do c = c + 1 end
				f:write(string.format("sm\t%d\t%s\t%s\t%d\n", id, se:name(), lvl(gv), c))
			end
		end
	end
	f:write("#end\n")
	f:close()
end

local function tb_walk_step()
	if not tb_route then
		tb_route = {}
		local sim, gg = alife(), game_graph()
		local here = g(function() return gg:vertex(db.actor:game_vertex_id()):level_id() end)
		for id = 0, 65534 do
			local se = sim:object(id)
			if se and se.npc_info ~= nil and here and g(function() return gg:vertex(se.m_game_vertex_id):level_id() end) == here then
				tb_route[#tb_route + 1] = se
			end
		end -- ascending id order by construction
		printf(string.format("* tb_walk: route of %d smart terrains, step every %d s", #tb_route, tb_walk))
	end
	if #tb_route == 0 or time_global() - start_t < (tb_step + 1) * tb_walk * 1000 then return end
	tb_step = tb_step + 1
	local se = tb_route[(tb_step - 1) % #tb_route + 1]
	local p = g(function() return level.vertex_position(se.m_level_vertex_id) end)
	if p then db.actor:set_actor_position(p) end
	printf(string.format("* tb_walk: step %d at engine_ms %d -> smart %d (%s) hp=%.3f", tb_step, time_global() - start_t, se.id, se:name(), db.actor.health))
end

local function tb_on_update()
	if not start_t then
		start_t = time_global()
		dump(0)
		tb_extra(0)
		get_console():execute("flush")
	end
	upd = upd + 1
	if tb_walk and tb_walk > 0 then tb_walk_step() end
	if done < total and time_global() - start_t >= (times[done + 1] or (done + 1) * interval) then
		done = done + 1
		dump(done)
		tb_extra(done)
		if done >= total then quit_at = upd end
		get_console():execute("flush")
	end
	if upd % 300 == 0 then get_console():execute("flush") end
	if quit_at and upd >= quit_at then
		quit_at = nil
		get_console():execute("quit")
	end
end

local function tb_start()
	-- pass counter (same definition as -det_counters: a frame in which an offline squad/smart script update ran);
	-- installed BEFORE the skip wrapper, so a skipped update is not counted
	local cls = sim_squad_scripted and sim_squad_scripted.sim_squad_scripted
	if cls then
		local counted_update = cls.update
		cls.update = function(self, ...) if not self.online then note_pass() end return counted_update(self, ...) end
	end
	local st = smart_terrain and smart_terrain.se_smart_terrain
	if st and st.update then
		local smart_update = st.update
		st.update = function(self, ...) if not self.online then note_pass() end return smart_update(self, ...) end
	end
	-- same rule as -det_perturb skip -det_perturb_n N
	if tb_skip_n > 0 and cls then
		local real_update = cls.update
		cls.update = function(self, ...)
			if tb_skip_done < tb_skip_n and start_t and time_global() - start_t >= tb_skip_at and not self.online then
				tb_skip_done = tb_skip_done + 1
				local t = time_global() - start_t
				tb_skip_first = tb_skip_first or t
				tb_skip_last = t
				if tb_skip_done == tb_skip_n then
					printf(string.format("* tb_skip: done n=%d skip_at_ms=%d first_ms=%d last_ms=%d", tb_skip_n, tb_skip_at, tb_skip_first, tb_skip_last))
				end
				return
			end
			return real_update(self, ...)
		end
	end
	if tb_lr_n > 0 and cls then
		local real_update2 = cls.update
		cls.update = function(self, ...)
			local r = real_update2(self, ...)
			if tb_lr_done < tb_lr_n and start_t and time_global() - start_t >= tb_lr_at and not self.online and self.smart_id then
				local smart = alife_object(self.smart_id)
				if smart and smart.unregister_npc then
					for k in self:squad_members() do
						local se = alife_object(k.id)
						if se and se.m_smart_terrain_id == self.smart_id then
							smart:unregister_npc(se)
							tb_lr_done = tb_lr_done + 1
							local t = time_global() - start_t
							tb_lr_first = tb_lr_first or t
							tb_lr_last = t
							if tb_lr_done == tb_lr_n then
								printf(string.format("* tb_lostreg: done n=%d at_ms=%d first_ms=%d last_ms=%d", tb_lr_n, tb_lr_at, tb_lr_first, tb_lr_last))
							end
							break
						end
					end
				end
			end
			return r
		end
	end
	RegisterScriptCallback("actor_on_update", tb_on_update)
	printf(string.format("* tb_dump: installed (tag %s, %d checkpoints, skip %d at %d ms, walk %s, lostreg %d at %d ms)", tag, total, tb_skip_n, tb_skip_at, tostring(tb_walk), tb_lr_n, tb_lr_at))
end

function on_game_start()
	if not active then
		if tb then tb_start() end
		return
	end
	-- Wall-clock-free os.time/os.clock for scripts (loadscreen.script seeds math.random from os.time() on every
	-- load screen). The engine-side override in script_storage.cpp does not survive to this point, so do it here.
	local os_time = os.time
	os.time = function(t) if t ~= nil then return os_time(t) end return 1700000000 + math.floor(time_global() / 1000) end
	os.clock = function() return time_global() / 1000 end
	-- Lua draw trace from script start (before the save is loaded): who calls math.random / math.randomseed, in
	-- order. Misses scripts that cached math.random in a local at load. Entries are "<update> <script:line> [seed]".
	if trace > 0 and debug and debug.getinfo then
		local real, realseed = math.random, math.randomseed
		local function where()
			local i = debug.getinfo(3, "Sl")
			return i and (i.short_src .. ":" .. i.currentline) or "?"
		end
		math.random = function(...)
			if #ltrace < 150000 then ltrace[#ltrace + 1] = upd .. " " .. where() end
			return real(...)
		end
		math.randomseed = function(v, ...)
			if #ltrace < 150000 then ltrace[#ltrace + 1] = upd .. " SEED " .. where() .. " " .. tostring(v) end
			return realseed(v, ...)
		end
	end
	-- -det_lua_streams (cause 8, Overseer ruling 2026-11-19; test only): scripts share ONE Lua random generator, so draws
	-- made near the player shift the sequence seen by A-Life and weather. Route math.random by WHICH SCRIPT IS CALLING:
	--   stream "alife"   : A-Life server-side scripts (squads, smart terrains, sim board, offline combat, server classes, spawners)
	--   stream "weather" : weather, emissions, psi storms
	--   everything else  : the stock shared generator, untouched
	-- Frames of this file and of generic helper files are skipped when looking for the caller. Each routed stream is its
	-- own Park-Miller generator with a fixed seed. Per call site counts are written to det_streams_<tag>.txt.
	if streams_on then
		local group = {}
		for n in string.gmatch("sim_board sim_squad_scripted sim_squad_bounty sim_squad_warfare zzz_sim_squad_scripted_milpda " ..
			"simulation_objects smart_terrain smart_terrain_warfare sim_offline_combat squads_filler " ..
			"se_stalker se_monster se_artefact se_item se_zones se_heli se_car se_level_changer se_smart_cover " ..
			"smr_pop smr_civil_war smr_loot heli_alife heli_alife_warfare", "%S+") do group[n] = "alife" end
		for n in string.gmatch("level_weathers surge_manager psi_storm_manager idiots_surge", "%S+") do group[n] = "weather" end
		local helper = { zz_eperf_dump = true, _g = true, utils_data = true, utils_obj = true, utils_item = true, util = true }
		local seed = { alife = 20071980, weather = 19860426 }
		local function draw(g, a, b)
			local x = (seed[g] * 16807) % 2147483647
			seed[g] = x
			stream_cnt[g] = stream_cnt[g] + 1
			stream_hash[g] = (stream_hash[g] * 31 + x + math.floor(tonumber(a) or 0) * 3 + math.floor(tonumber(b) or 0) * 5) % 2147483647
			local u = (x - 1) / 2147483646
			if a == nil then return u end
			if b == nil then return math.floor(u * a) + 1 end
			return a + math.floor(u * (b - a + 1))
		end
		stream_seed, stream_draw = seed, draw
		local shared = math.random
		math.random = function(a, b)
			local name, line = "?", 0
			for lv = 2, 9 do
				local i = debug.getinfo(lv, "Sl")
				if not i then break end
				name = string.match(i.short_src, "([^\\/]+)%.%a+$") or i.short_src
				line = i.currentline
				if not helper[name] then break end
			end
			local g = group[name]
			local key = (g or "shared") .. " " .. name .. ":" .. line
			stream_sites[key] = (stream_sites[key] or 0) + 1
			if g then return draw(g, a, b) end
			if a == nil then return shared() elseif b == nil then return shared(a) end
			return shared(a, b)
		end
		printf("* det_lua_streams: installed")
	end
	if counters_on and sim_squad_scripted and sim_squad_scripted.sim_squad_scripted then
		-- installed BEFORE the skip wrapper, so a skipped update is not counted
		local cls = sim_squad_scripted.sim_squad_scripted
		local function rec(id) local r = sq_cnt[id] if not r then r = { 0, 0, 0, 0 } sq_cnt[id] = r end return r end
		local function sig(o) return tostring(o.current_action) .. "/" .. tostring(o.assigned_target_id) end
		local counted_update = cls.update
		cls.update = function(self, ...)
			local r = rec(self.id)
			r[1] = r[1] + 1
			if not self.online then note_pass() end
			local before = sig(self)
			local a, b = counted_update(self, ...)
			if sig(self) ~= before then r[3] = r[3] + 1 end
			return a, b
		end
		if cls.on_npc_death then
			local real_death = cls.on_npc_death
			cls.on_npc_death = function(self, ...) local r = rec(self.id) r[4] = r[4] + 1 return real_death(self, ...) end
		end
		local st = smart_terrain and smart_terrain.se_smart_terrain
		if st and st.update then
			local smart_update = st.update
			st.update = function(self, ...) if not self.online then note_pass() end return smart_update(self, ...) end
		end
		local bcls = sim_board and sim_board.simulation_board
		if bcls and bcls.get_squad_target then
			local counted_target = bcls.get_squad_target
			bcls.get_squad_target = function(self, squad, ...)
				if squad then local r = rec(squad.id) r[2] = r[2] + 1 end
				return counted_target(self, squad, ...)
			end
		end
		RegisterScriptCallback("server_entity_on_register", function() info_cnt.register = info_cnt.register + 1 end)
		RegisterScriptCallback("server_entity_on_unregister", function() info_cnt.unregister = info_cnt.unregister + 1 end)
		printf("* det_counters: installed")
	end
	if perturb == "skip" and sim_squad_scripted and sim_squad_scripted.sim_squad_scripted then
		local cls = sim_squad_scripted.sim_squad_scripted
		local real_update = cls.update
		cls.update = function(self, ...)
			if perturb_done < perturb_n and start_t and time_global() - start_t >= perturb_at and not self.online then
				perturb_done = perturb_done + 1
				perturbed = true
				if perturb_done <= 3 or perturb_done == perturb_n then
					printf(string.format("* det_perturb skip: skipped update %d of %d, offline squad %s (%s)", perturb_done, perturb_n, tostring(self.id), tostring(self:name())))
				end
				return
			end
			return real_update(self, ...)
		end
		printf("* det_perturb skip: wrapper installed")
	end
	if perturb == "decision" and sim_board and sim_board.simulation_board then
		local cls = sim_board.simulation_board
		local real_target = cls.get_squad_target
		cls.get_squad_target = function(self, squad, ...)
			if not perturbed and start_t and time_global() - start_t >= perturb_at and squad and not squad.online then
				perturbed = true
				printf(string.format("* det_perturb decision: one extra math.random (%d) before target choice of offline squad %s (%s)",
					math.random(1, 1000000000), tostring(squad.id), tostring(squad:name())))
			end
			return real_target(self, squad, ...)
		end
		printf("* det_perturb decision: wrapper installed")
	end
	RegisterScriptCallback("actor_on_update", on_update)
end
