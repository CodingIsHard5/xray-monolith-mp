-- Test-only (EnginePerf): time every player's script update on the co-op SERVER, per actor. Active ONLY with -fp_svtime.
-- With -fp_inert the update of every actor except the host's (id 0) is replaced by an empty function (control 2).
-- Totals per actor id go to $logs$/sv_binder.csv (overwritten about once a second of calls).
local cl = command_line and command_line() or ""
local on = string.find(cl, "-fp_svtime", 1, true) ~= nil
local inert2 = string.find(cl, "-fp_inert2", 1, true) ~= nil  -- corrected inert: stock first update (errors caught), then empty
local inert = (not inert2) and string.find(cl, "-fp_inert", 1, true) ~= nil
local per = {}   -- id -> { calls, us, first_tg, last_tg }
local total = 0
local function timer()
	if profile_timer then local t = profile_timer() t:start() return function() t:stop() return t:time() end end
	local c = os.clock() return function() return (os.clock() - c) * 1e6 end
end
local function write()
	local f = io.open(getFS():update_path("$logs$", "sv_binder.csv"), "w")
	if not f then return end
	f:write("actor_id,calls,total_ms,first_time_ms,last_time_ms,inert\n")
	for id, r in pairs(per) do
		f:write(string.format("%d,%d,%.3f,%d,%d,%s\n", id, r[1], r[2] / 1000, r[3], r[4], tostring((inert or inert2) and id ~= 0)))
	end
	f:close()
end
function on_game_start()
	if not on then return end
	local ab = bind_stalker and bind_stalker.actor_binder
	if not (ab and ab.update) then printf("* sv_binder: actor binder NOT found") return end
	local real = ab.update
	ab.update = function(self, delta)
		local id = self.object and self.object:id() or -1
		local r = per[id]
		if not r then r = { 0, 0, time_global(), 0 } per[id] = r printf("* sv_binder: first update of actor id %s", id) end
		local stop = timer()
		local a
		if inert and id ~= 0 then a = nil
		elseif inert2 and id ~= 0 then
			if r[1] == 0 then
				local ok, err = pcall(real, self, delta)
				printf("* sv_binder: actor id %s stock first update ran, ok=%s %s", id, tostring(ok), ok and "" or tostring(err))
			end
		else a = real(self, delta) end
		r[2] = r[2] + stop()
		r[1] = r[1] + 1
		r[4] = time_global()
		total = total + 1
		if total % 100 == 0 or r[1] == 1 then write() end
		return a
	end
	-- A-Life rate trace: stock writes 65,534 in actor_binder:reinit and resets to 20 from a timed event queued by the first
	-- update. The value cannot be read back from script on this build, so both writers are logged with the game clock.
	if ab.reinit then
		local real_reinit = ab.reinit
		ab.reinit = function(self, ...)
			local a = real_reinit(self, ...)
			printf("* sv_binder: RATE reinit (stock sets 65534) actor id %s t=%s", self.object and self.object:id() or -1, time_global())
			return a
		end
	end
	if CreateTimeEvent then
		local real_cte = CreateTimeEvent
		_G.CreateTimeEvent = function(ev_id, act_id, timer, f, ...) -- on _G: a bare assignment only lands in this script's own namespace
			if act_id == "obj_per_upd" and type(f) == "function" then
				local stock = f
				printf("* sv_binder: RATE reset queued t=%s", time_global())
				f = function(...) local r = stock(...) printf("* sv_binder: RATE reset ran (stock sets 20) t=%s", time_global()) return r end
			end
			return real_cte(ev_id, act_id, timer, f, ...)
		end
	end
	-- A-Life online radius trace (control: must stay at its stock value). Runs from a level-wide call, so it also
	-- logs with no player joined. One line every 5 s of engine time, and at once on any change.
	local last_r, last_t = nil, -100000
	local function radius_watch()
		local sim = alife()
		if sim and sim.switch_distance then
			local r, t = sim:switch_distance(), time_global()
			if r ~= last_r or t - last_t >= 5000 then
				printf("* sv_binder: RADIUS %s t=%s%s", tostring(r), t, (last_r ~= nil and r ~= last_r) and " CHANGED" or "")
				last_r, last_t = r, t
			end
		end
		return false
	end
	if AddUniqueCall then AddUniqueCall(radius_watch) else printf("* sv_binder: AddUniqueCall missing, RADIUS not traced") end
	printf("* sv_binder: installed, inert=%s inert2=%s", tostring(inert), tostring(inert2))
end
