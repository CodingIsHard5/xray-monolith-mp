-- P1 puppet probe (engine/perf-harness/PREREG-P1-puppet-2026-11-23.md). INERT unless the command line has -p1.
--   -p1                 move the actor along gamedata\configs\p1_track.csv at 20 Hz (track time from the first teleport);
--                       off-mesh points (node_dist < 0) hold the last on-mesh point; every hit on the actor is logged and
--                       cancelled (invulnerable); health below 0.5 is refilled (backup, logged)
--   -p1_export          also export online monsters/stalkers at 10 Hz
--   -p1_tag <t>         file tag. Z:\dev\shm\p1\export_<t>.csv holds ONLY ITRZone's formats (no header):
--                         a,t,x,y,z,health | o,t,id,section,kind,x,y,z,health,best_enemy,distance | h,t,hitter_id,hitter_section,hitter_kind,type,power,bone
--                       (kind m = is_monster, s = is_stalker; hitter_kind also a = actor, x = other/none). Everything else
--                       (start, ON/OFF, refills, ticks, summary) goes to Z:\dev\shm\p1\meta_<t>.csv.
--   -b1_snap            B1-T1 (perf-harness/PREREG-B1-T1-2026-11-23.md): the 10 Hz export REWRITES
--                       Z:\dev\shm\itrz_b1\snap.txt in place each tick (open "w", write, close; os.rename is removed):
--                         seq,<seq>,<t_xray_ms>,<t_track_s> | a,x,y,z,yaw,health | o,id,section,kind,x,y,z,yaw,health,alive,best_enemy,dist | end,<seq>
--                       instead of P1's CSV. Meta goes to Z:\dev\shm\itrz_b1\meta_<t>.csv (plus W,<seq>,<us> per tick) and
--                       hit lines to hits_<t>.csv there. Implies -p1_export. Without -b1_snap, P1 behaves exactly as before.
--   -t2_pose            B1-T2 (perf-harness/PREREG-B1-T2-xray-side-2026-11-23.md). Implies -b1_snap. The track is NOT
--                       used: the actor follows Z:\dev\shm\itrz_b1\pose.txt (ITRZone's writer):
--                         seq,<n>,<utc_ms>,<state>,<zone>,<keep|freeze> | p,x,y,z,yaw_rad,hp | k,<id>... | end,<n>
--                       The snapshot header gains <level>,<run_id> (run_id from -t2_run <utc ms of launch>, set by the
--                       driver on every start). Meta lines: P (pose applied), STALE/RESUME, HOLD (off-mesh), KILL, PAUSE.
--                       -t2_pause allows device():pause on away/dead + freeze (only after the pre-flight boot check).
--                       Without -t2_pose every path is exactly as in T1.
--   Track time t starts WAIT_MS after the first update (the actor holds the t=0 point meanwhile, t < 0), so GAMMA's
--   auto_switch (1250 m for 10 s after load, then 450 m; configs\alife.ltx) has settled before the track starts.
local cl = command_line and command_line() or ""
local active = string.find(cl, "-p1", 1, true) ~= nil
if not active then return end
local t2 = string.find(cl, "-t2_pose", 1, true) ~= nil
local b1 = t2 or string.find(cl, "-b1_snap", 1, true) ~= nil
local t2_run = string.match(cl, "%-t2_run%s+(%d+)") or "0"
local t2_pause_ok = string.find(cl, "-t2_pause", 1, true) ~= nil
-- B1-T2 freeze compensation (engine perf/freeze-absorb): -t2_absorb <ms> turns absorbing on (g_freeze_absorb_ms); the
-- script ARMS it (g_freeze_absorb_armed 1) when the pose turns dead/away + freeze, BEFORE the bridge suspends the
-- process (the bridge waits for the ABSORB_ARM line), and disarms on play. -t2_absorb_skip <k> leaves the first k
-- freezes unarmed (pre-flight 3: the first freeze is the "absorb off" control).
local t2_absorb = tonumber(string.match(cl, "%-t2_absorb%s+(%d+)") or "0")
local t2_absorb_skip = tonumber(string.match(cl, "%-t2_absorb_skip%s+(%d+)") or "0")
local t2_nfreeze, t2_armed = 0, false
local function gtime() local v = game.time(); if v < 0 then v = v + 4294967296 end; return v end   -- u32 game ms (pre-flight 2 printed it as a negative int)
local do_export = b1 or string.find(cl, "-p1_export", 1, true) ~= nil
local DIR = b1 and "Z:\\dev\\shm\\itrz_b1\\" or "Z:\\dev\\shm\\p1\\"
local seq = 0
local tag = string.match(cl, "%-p1_tag%s+(%S+)") or "p1"

local trk_t, trk_x, trk_y, trk_z, trk_ok = {}, {}, {}, {}, {}
local out, meta, t0 = nil, nil, nil
local last_move, last_exp, idx, held = -1e9, -1e9, 1, false
local hits, cancels, refills, min_health = 0, 0, 0, 1
local exp_n, exp_sum, exp_max, exp_times = 0, 0, 0, {}
local seen = {}

local WAIT_MS = 15000
local function w(s) if out then out:write(s, "\n") end end
local function m(s) if meta then meta:write(s, "\n") end end
local function kind(o) if not o then return "x" end; if o:id() == 0 then return "a" end; if o:is_monster() then return "m" end; if o:is_stalker() then return "s" end; return "x" end

local function load_track()
	local f = io.open(getFS():update_path("$game_config$", "p1_track.csv"), "r")
	if not f then printf("p1: NO TRACK FILE"); return false end
	f:read("*l")
	for line in f:lines() do
		local t, x, y, z, nd = string.match(line, "([^,]+),([^,]+),([^,]+),([^,]+),([^,]+)")
		if t then local n = #trk_t + 1
			trk_t[n], trk_x[n], trk_y[n], trk_z[n], trk_ok[n] = tonumber(t), tonumber(x), tonumber(y), tonumber(z), tonumber(nd) >= 0 end
	end
	f:close(); printf("p1: track %d points, %.1f s", #trk_t, trk_t[#trk_t]); return #trk_t > 1
end

-- position at track time t: linear between samples; off-mesh -> last on-mesh point (held)
local lx, ly, lz
local function track_pos(t)
	while idx < #trk_t and trk_t[idx + 1] <= t do idx = idx + 1 end
	local a, b = idx, math.min(idx + 1, #trk_t)
	if not (trk_ok[a] and trk_ok[b]) then held = true; return lx, ly, lz end
	held = false
	local f = (trk_t[b] > trk_t[a]) and math.max(0, math.min(1, (t - trk_t[a]) / (trk_t[b] - trk_t[a]))) or 0
	lx, ly, lz = trk_x[a] + (trk_x[b] - trk_x[a]) * f, trk_y[a] + (trk_y[b] - trk_y[a]) * f, trk_z[a] + (trk_z[b] - trk_z[a]) * f
	return lx, ly, lz
end

local function yaw(o) local d = o:direction(); return math.atan2(d.x, d.z) end

-- B1-T1: build the whole snapshot, then rewrite snap.txt in place (the reader keeps it only if seq == end seq)
local function export_b1(now, t, tm)
	seq = seq + 1
	local a = db.actor; local ap = a:position(); local present = {}
	local hdr = t2 and string.format("seq,%d,%d,%.2f,%s,%s", seq, now, t, level.name(), t2_run) or string.format("seq,%d,%d,%.2f", seq, now, t)
	local L = { hdr, string.format("a,%.3f,%.3f,%.3f,%.4f,%.4f", ap.x, ap.y, ap.z, yaw(a), a.health) }
	for id, st in pairs(db.storage) do
		local o = st.object
		if o and id ~= 0 and (o:is_monster() or o:is_stalker()) then
			present[id] = true
			local p = o:position(); local be = o:best_enemy()
			L[#L + 1] = string.format("o,%d,%s,%s,%.3f,%.3f,%.3f,%.4f,%.4f,%d,%d,%.2f", id, o:section(), kind(o), p.x, p.y, p.z, yaw(o),
				o.health, o:alive() and 1 or 0, be and be:id() or -1, p:distance_to(ap))
			if not seen[id] then m(string.format("ON,%.2f,%d,%d,%s,%.1f", t, now, id, o:section(), p:distance_to(ap))) end
		end
	end
	for id in pairs(seen) do if not present[id] then m(string.format("OFF,%.2f,%d,%d", t, now, id)) end end
	seen = present
	L[#L + 1] = string.format("end,%d", seq)
	local f = io.open(DIR .. "snap.txt", "wb")   -- binary: Windows text mode would write CRLF (T1 run 1 failure)
	if f then f:write(table.concat(L, "\n"), "\n"); f:close() else m(string.format("WFAIL,%d", seq)) end
	tm:stop(); local us = tm:time()
	m(string.format("W,%d,%.0f", seq, us))
	if out then out:flush() end; if meta then meta:flush() end
	exp_n, exp_sum = exp_n + 1, exp_sum + us; if us > exp_max then exp_max = us end; exp_times[exp_n] = us
end

local function export(now, t)
	local tm = profile_timer(); tm:start()
	if b1 then return export_b1(now, t, tm) end
	local a = db.actor; local ap = a:position(); local present = {}
	w(string.format("a,%.2f,%.3f,%.3f,%.3f,%.4f", t, ap.x, ap.y, ap.z, a.health))
	for id, st in pairs(db.storage) do
		local o = st.object
		if o and id ~= 0 and (o:is_monster() or o:is_stalker()) then
			present[id] = true
			local p = o:position(); local be = o:best_enemy()
			w(string.format("o,%.2f,%d,%s,%s,%.3f,%.3f,%.3f,%.4f,%d,%.2f", t, id, o:section(), kind(o), p.x, p.y, p.z, o.health,
				be and be:id() or -1, p:distance_to(ap)))
			if not seen[id] then m(string.format("ON,%.2f,%d,%d,%s,%.1f", t, now, id, o:section(), p:distance_to(ap))) end
		end
	end
	for id in pairs(seen) do if not present[id] then m(string.format("OFF,%.2f,%d,%d", t, now, id)) end end
	seen = present
	if out then out:flush(); meta:flush() end
	tm:stop(); local us = tm:time()
	exp_n, exp_sum = exp_n + 1, exp_sum + us; if us > exp_max then exp_max = us end; exp_times[exp_n] = us
end

-- B1-T2 pose reader: accept only seq,n ... end,n with n newer; strip \r (Wine CRLF); torn reads counted
local p_last, p_last_t, p_stale, p_torn, p_holds, p_paused, p_lx, p_ly, p_lz = 0, nil, false, 0, 0, false, nil, nil, nil
local T2_NEAR_CELLS, T2_NEAR_H, p_near = 2, 2.0, 0   -- on-mesh test: +-2 cells (1.4 m), +-2.0 m (prereg section 24)
-- The pose is on the mesh if an AI node lies within +-T2_NEAR_CELLS cells (0.7 m each) in x and z and within T2_NEAR_H m
-- in height. level.vertex_id picks the highest node at or below the y it is given (else the lowest above), so probing
-- at y + H and requiring node y >= y - H means "any node in [y - H, y + H]". The pose's own cell is ring 0 and is
-- tried first. Returns the ring found (0..T2_NEAR_CELLS) or nil. r1/r1b/r2: the old own-cell-only test held 9 % of
-- an on-mesh track.
-- T3 grounding (DESIGN-T3-xray-side-2026-11-24.md; prereg section 33). Pose v2 carries yfloor = ITR2 feet + 0.3 m, a hint
-- that only picks the floor. X-Ray finds its own AI node: the highest node at or below yfloor + T3_PROBE_UP (else the
-- lowest above), in the pose's cell or within +-T2_NEAR_CELLS cells, accepted if within T3_BAND m of the ITR2 feet.
-- Returns ring, node id, node height; or nil.
-- real movement state of the actor, as GAMMA's vision script reads it: 0 stand, 1 crouch, 2 low crouch, -1 = cannot read
local mv_frames, mv_crouch, mv_low, mv_na = 0, 0, 0, 0
local vit_rad, vit_bleed, vit_na = 0, 0, 0
local function mvstate()
	if not IsMoveState then return -1 end
	local ok, cr = pcall(IsMoveState, 'mcCrouch'); if not ok then return -1 end
	if not cr then return 0 end
	local ok2, ac = pcall(IsMoveState, 'mcAccel'); return (ok2 and ac) and 2 or 1
end
local t3_cross_done, t3_crossed = false, nil
local dmg_mode, dmg_hold = nil, false   -- pre-flight E test mode (see dmg_step); nil = off
-- every level changer in the save: name, level it stands on, destination level, destination position / vertices
local function t3_changers()
	local L, sim, gg = {}, alife(), game_graph()
	for id = 1, 65534 do
		local se = sim:object(id)
		if se and se:clsid() == clsid.level_changer_s then
			local ok, dg = pcall(function() return se.dest_game_vertex_id end)
			if ok and dg then
				L[#L + 1] = { name = se:name(), from = sim:level_name(gg:vertex(se.m_game_vertex_id):level_id()), to = sim:level_name(gg:vertex(dg):level_id()),
					pos = se.dest_position, lvid = se.dest_level_vertex_id, gvid = dg, at = se.position }
			end
		end
	end
	return L
end
-- with a name (pose line `c,<changer name>`, R3): only that changer, and only if it leads from here to <to>; no fallback
local function t3_find_changer(to, name)
	local here = level.name()
	for _, c in ipairs(t3_changers()) do if c.from == here and c.to == to and (not name or c.name == name) then return c end end
end
local T3_PROBE_UP, T3_BAND, T3_LIFT, T3_YTOL, T3_GUARD = 0.7, 3.0, 0.05, 0.7, 5.0
local t3_ray, t3_ray_warned, t3_ly
local t3_gx, t3_gy, t3_gz, t3_guards, t3_stance_last, t3_stance_warned = nil, nil, nil, 0, nil, false
local function t3_ground(x, yfloor, z)
	local feet = yfloor - 0.3
	for ring = 0, T2_NEAR_CELLS do
		for dx = -ring, ring do
			for dz = -ring, ring do
				if math.max(math.abs(dx), math.abs(dz)) == ring then
					local vid = level.vertex_id(vector():set(x + dx * 0.7, yfloor + T3_PROBE_UP, z + dz * 0.7))
					if vid ~= 4294967295 then
						local ny = level.vertex_position(vid).y
						if math.abs(ny - feet) <= T3_BAND then return ring, vid, ny end
					end
				end
			end
		end
	end
	return nil
end
local function t2_near_ring(x, y, z)
	for ring = 0, T2_NEAR_CELLS do
		for dx = -ring, ring do
			for dz = -ring, ring do
				if math.max(math.abs(dx), math.abs(dz)) == ring then
					local vid = level.vertex_id(vector():set(x + dx * 0.7, y + T2_NEAR_H, z + dz * 0.7))
					if vid ~= 4294967295 and level.vertex_position(vid).y >= y - T2_NEAR_H then return ring end
				end
			end
		end
	end
	return nil
end
local p_killed, p_torn_n = {}, nil
local g_last_wall, g_f_until, g_last_g, p_fz_logged, g_prev_tg, g_prev_game = nil, nil, nil, false, nil, nil
-- Absorb arming (prereg section 28). The engine flag g_freeze_absorb_armed may be 1 ONLY while the bridge is about to
-- stop, or has stopped, X-Ray: pose state dead or away with `freeze` (exactly the bridge's own test in t2_xray.sh).
-- It is cleared: on a play pose; on any pose that is not dead/away + freeze; when the pose is STALE and X-Ray is still
-- running T2_ARM_STALE_MS after arming; T2_ARM_MAX_MS after arming if X-Ray is still running; and at game end.
-- The bridge stops X-Ray within ~3 s of the ARM line (it waits at most 3 s for it), so X-Ray still running 4 s after
-- arming means no stop is coming: bridge gone, or not freezing. While X-Ray is stopped no Lua runs, and the absorbed
-- gap does not advance time_global, so a real freeze never reaches these limits. r2b: the old script armed on ITR2's last non-play pose, which the
-- bridge does not treat as a freeze, and stayed armed ~6 min.
local T2_ARM_MAX_MS, T2_ARM_STALE_MS, t2_eng_armed, t2_arm_tg = 10000, 4000, false, nil
local function t2_disarm(now, n, why)
	if not t2_eng_armed then return end
	t2_eng_armed = false; get_console():execute("g_freeze_absorb_armed 0")
	m(string.format("ABSORB_DISARM,%d,%d,%.0f,%s", now, n, gtime(), why)); if meta then meta:flush() end
end
local function t2_stale(now, t)
	p_stale = true; m(string.format("STALE,%.2f,%d,%d", t, now, p_last))
end
local function t2_pose(a, now, t)
	if t2_eng_armed and t2_arm_tg then
		if p_stale and now - t2_arm_tg >= T2_ARM_STALE_MS then t2_disarm(now, p_last, "stale")
		elseif now - t2_arm_tg >= T2_ARM_MAX_MS then t2_disarm(now, p_last, "timeout") end
	end
	local f = io.open(DIR .. "pose.txt", "rb"); if not f then return end
	local first = f:read("*l"); first = first and string.gsub(first, "\r", "")
	local n = first and tonumber(string.match(first, "^seq,(%d+),"))
	if not n or n <= p_last then f:close()
		if p_last_t and not p_stale and now - p_last_t >= 1000 then t2_stale(now, t) end
		return end
	local rest = f:read("*a") or ""; f:close()
	local _, utc, state, zone, aw = string.match(first, "^seq,(%d+),(%d+),([^,]+),([^,]+),([^,]+)$")
	local px, py, pz, pyaw, pstance, pchanger; local kills = {}; local endn
	for line in string.gmatch(rest, "[^\r\n]+") do
		local x, y, z, yw = string.match(line, "^p,([^,]+),([^,]+),([^,]+),([^,]+),")
		if x then px, py, pz, pyaw = tonumber(x), tonumber(y), tonumber(z), tonumber(yw)
			-- pose v2 (T3): p,x,yfloor,z,yaw,hp,stance  (6 fields after p; v1 has 5 and no stance)
			pstance = tonumber(string.match(line, "^p,[^,]+,[^,]+,[^,]+,[^,]+,[^,]+,(%d+)$")) end
		local cn = string.match(line, "^c,([%w_]+)$"); if cn then pchanger = cn end
		local k = string.match(line, "^k,(%d+)$"); if k then kills[#kills + 1] = tonumber(k) end
		local e = string.match(line, "^end,(%d+)$"); if e then endn = tonumber(e) end
	end
	if endn ~= n or not utc or not px then   -- torn: count and log once per seq; a file left torn still goes stale
		if n ~= p_torn_n then p_torn_n = n; p_torn = p_torn + 1; m(string.format("TORN,%d,%d", now, n)) end
		if p_last_t and not p_stale and now - p_last_t >= 1000 then t2_stale(now, t) end
		return end
	p_last = n; p_last_t = now
	if p_stale then p_stale = false; m(string.format("RESUME,%.2f,%d,%d", t, now, n)) end
	-- R3 (T3): pose state `cross` with a zone that is not this level = ITR2's player crossed to that level. Find a
	-- level changer on this level that leads there and change level through it. ChangeLevel acts at once and the Lua
	-- state does not survive, so the log line and the marker file are written first. No arm, no stop.
	if state == "cross" and zone ~= level.name() then
		if not t3_cross_done then t3_cross_done = true
			local ok, c = pcall(t3_find_changer, zone, pchanger)
			if not ok then m(string.format("CROSS_ERROR,%d,%d,%s", now, n, tostring(c)))
			elseif not c then m(string.format("CROSS_NOCHANGER,%d,%d,%s,%s,%s", now, n, level.name(), zone, tostring(pchanger)))
			else
				m(string.format("CROSS_REQ,%d,%d,%s,%s,%s,%.3f,%.3f,%.3f,%d,%d,%s", now, n, level.name(), zone, c.name, c.pos.x, c.pos.y, c.pos.z, c.lvid, c.gvid, utc))
				if meta then meta:flush() end
				local f = io.open(DIR .. "cross.txt", "wb"); if f then f:write(level.name(), ",", zone, ",", utc, "\n"); f:close() end
				ChangeLevel(c.pos, c.lvid, c.gvid, vector():set(0, 0, 0))
			end
		end
		return
	end
	if zone ~= level.name() then m(string.format("ZONE_MISMATCH,%d,%d,%s", now, n, zone)); return end
	for _, id in ipairs(kills) do
		if not p_killed[id] then local o = level.object_by_id(id)
			if o and o:alive() then o:kill(a); p_killed[id] = true; m(string.format("KILL,%d,%d,%d", now, n, id)) end end
	end
	local hold_state = state ~= "play"
	local fz_state = (state == "dead" or state == "away") and aw == "freeze"   -- the bridge's own freeze test
	if fz_state and not t2_armed and t2_absorb > 0 then
		t2_armed = true; t2_nfreeze = t2_nfreeze + 1
		if t2_nfreeze > t2_absorb_skip then
			get_console():execute("g_freeze_absorb_armed 1"); t2_eng_armed = true; t2_arm_tg = now
			m(string.format("ABSORB_ARM,%d,%d,%.0f", now, n, gtime()))
		else m(string.format("ABSORB_SKIP,%d,%d,%.0f", now, n, gtime())) end
		if meta then meta:flush() end
	elseif not fz_state and t2_armed then
		t2_armed = false
		if t2_eng_armed then t2_disarm(now, n, hold_state and "state" or "play")
		else m(string.format("ABSORB_DISARM,%d,%d,%.0f,%s", now, n, gtime(), hold_state and "state_noop" or "play_noop")) end
	end
	if hold_state and aw == "freeze" and not p_paused then
		if t2_pause_ok then device():pause(true); p_paused = true; m(string.format("PAUSE,%d,%d,%s", now, n, state))
		elseif not p_fz_logged then p_fz_logged = true; m(string.format("FREEZE_UNSUPPORTED,%d,%d,%s", now, n, state)) end   -- once
	elseif not hold_state and p_paused then device():pause(false); p_paused = false; m(string.format("UNPAUSE,%d,%d", now, n)) end
	if hold_state or dmg_hold then return end
	if pstance then   -- pose v2: X-Ray grounds its own actor
		local ring, vid, ny = t3_ground(px, py, pz)
		if not ring then p_holds = p_holds + 1; m(string.format("HOLD,%d,%d,nonode", now, n))
			a:set_actor_direction(pyaw); return end
		if ring > 0 then p_near = p_near + 1 end
		-- height: the node height plus a small lift, on EVERY set. Pre-flight A (2026-11-24) showed the actor's height
		-- never changes between sets (physics does not settle it), so "keep the current height" left it up to 0.78 m
		-- under the node. snap = 1 only marks a height step larger than T3_YTOL (report).
		local cur = a:position(); local ty = ny + T3_LIFT; local snap = 0
		local drift = t3_ly and (cur.y - t3_ly) or 0; t3_ly = ty   -- how far the engine moved the height since the last set (report)
		if math.abs(cur.y - ty) > T3_YTOL then snap = 1 end
		-- measured only, never applied: a ray straight down onto static geometry from 1.2 m above the node
		local ry = -9999
		if ray_pick then
			local ok, hit, dist = pcall(function()
				t3_ray = t3_ray or ray_pick()
				t3_ray:set_position(vector():set(px, ny + 1.2, pz)); t3_ray:set_direction(vector():set(0, -1, 0))
				t3_ray:set_flags(2); t3_ray:set_range(3.0)
				return t3_ray:query(), t3_ray:get_distance()
			end)
			if ok and hit and dist then ry = ny + 1.2 - dist elseif not ok and not t3_ray_warned then t3_ray_warned = true; m(string.format("RAY_ERROR,%d,%d,%s", now, n, tostring(hit))) end
		end
		a:set_actor_position(vector():set(px, ty, pz), true, snap == 0)   -- skip the collision corrector (r3: 90 m throws); keep fall speed unless snapping
		a:set_actor_direction(pyaw)
		if a.set_actor_stance then
			if pstance ~= t3_stance_last then m(string.format("STANCE,%d,%d,%d", now, n, pstance)); t3_stance_last = pstance end
			a:set_actor_stance(pstance)
		elseif not t3_stance_warned then t3_stance_warned = true; m(string.format("STANCE_UNSUPPORTED,%d,%d", now, n)) end
		local got = a:position(); local dxz = math.sqrt((got.x - px) ^ 2 + (got.z - pz) ^ 2); local d3 = got:distance_to(vector():set(px, ty, pz))
		if d3 > T3_GUARD then   -- guard (Overseer): put the actor back to the last good position and log it
			t3_guards = t3_guards + 1
			m(string.format("GUARD,%d,%d,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f", now, n, d3, px, ty, pz, got.x, got.y, got.z))
			if t3_gx then a:set_actor_position(vector():set(t3_gx, t3_gy, t3_gz), true) end
		else t3_gx, t3_gy, t3_gz = got.x, got.y, got.z end
		-- P2: seq, utc, tg, horizontal distance, pose yaw, actor yaw, target x,y,z, node id, node y, ring, snap, actor y after set, stance, ray ground y (-9999 = no hit; measured only), height drift since the last set, real movement state (0/1/2, -1 unread), get_actor_stance (-9 = no export)
		m(string.format("P2,%d,%s,%d,%.3f,%.4f,%.4f,%.3f,%.3f,%.3f,%d,%.3f,%d,%d,%.3f,%d,%.3f,%.3f,%d,%d", n, utc, now, dxz, pyaw, yaw(a), px, ty, pz, vid, ny, ring, snap, got.y, pstance, ry, drift, mvstate(), a.get_actor_stance and a:get_actor_stance() or -9))
		return
	end
	local v = vector():set(px, py, pz)
	local how = t2_near_ring(px, py, pz)   -- on-mesh test, prereg section 24
	if how then
		p_lx, p_ly, p_lz = px, py, pz
		if how > 0 then p_near = p_near + 1; m(string.format("NEAR,%d,%d,%d", now, n, how)) end
	else p_holds = p_holds + 1; m(string.format("HOLD,%d,%d,nonear", now, n)) end
	if p_lx then a:set_actor_position(vector():set(p_lx, p_ly, p_lz)) end
	a:set_actor_direction(pyaw)   -- sign checked at the pre-flight boot
	m(string.format("P,%d,%s,%d,%.3f,%.4f,%.4f", n, utc, now, a:position():distance_to(v), pyaw, yaw(a)))   -- pose yaw, actor yaw read back
end

local done_logged = false
-- pre-flight E (prereg section 46): forced-damage test mode. ON only if the bridge tmpfs holds dmgtest.txt with
-- prot | god_off | god_off_norefill (written and removed by tools/t2_preflight.sh only). Without the file nothing here runs.
-- Phases by track time: rad 20-80 s (actor pinned at the nearest radiation field's centre), anom 80-140 s (nearest
-- damaging anomaly), mut 150-240 s (three hostile mutants spawned 4 m from the actor, which the pose holds in place).
local dmg_phase, dmg_tgt, dmg_last, dmg_spawned = nil, nil, 0, {}
local dmg_ph = { hits0 = 0, minh = 1, maxr = 0, maxb = 0 }
local DMG_T = { { "rad", 20, 80 }, { "anom", 80, 140 }, { "mut", 150, 240 } }   -- 10 s between anom and mut: the pose takes the actor home first
local DMG_MUT = { "dog_strong_red", "boar_01a_hard", "cat_strong_a" }
local function dmg_find(k)
	local sim, gg, here, ap = alife(), game_graph(), level.name(), db.actor:position()
	local best, bd
	for id = 1, 65534 do
		local se = sim:object(id)
		if se then
			local sec = se:section_name()
			local hit = (k == "rad" and string.find(sec, "^zone_field_radioactive")) or (k == "anom" and string.find(sec, "^zone_mine_")
				and (string.find(sec, "electr") or string.find(sec, "acid") or string.find(sec, "chem") or string.find(sec, "therm") or string.find(sec, "gravit")))
			if hit and sim:level_name(gg:vertex(se.m_game_vertex_id):level_id()) == here then
				local d = se.position:distance_to(ap)
				if not bd or d < bd then best, bd = { id = id, name = se:name(), sec = sec, pos = se.position }, d end
			end
		end
	end
	return best, bd
end
local function dmg_end_phase(a, now)
	if not dmg_phase then return end
	m(string.format("DMG_PHASE_END,%s,%d,hits=%d,min_health=%.3f,max_radiation=%.4f,max_bleeding=%.4f", dmg_phase, now, hits - dmg_ph.hits0, dmg_ph.minh, dmg_ph.maxr, dmg_ph.maxb))
	if dmg_mode ~= "prot" then   -- witnesses: each phase starts from full health and no radiation (retry, section 47)
		local ok, r = pcall(function() local r0 = a.radiation; a:change_radiation(-r0); return r0 end)
		a:set_health_ex(1.0); m(string.format("DMG_RESET,%s,%d,%s", dmg_phase, now, ok and string.format("%.4f", r) or "error"))
	end
	dmg_hold = false; dmg_tgt = nil; dmg_phase = nil; if meta then meta:flush() end
end
local function dmg_step(a, now, t)
	local cur
	for _, p in ipairs(DMG_T) do if t >= p[2] and t < p[3] then cur = p[1] end end
	if cur ~= dmg_phase then
		dmg_end_phase(a, now)
		if cur then
			dmg_phase = cur; dmg_ph = { hits0 = hits, minh = a.health, maxr = 0, maxb = 0 }
			if cur == "mut" then
				local ap = a:position(); local off = { { 4, 0 }, { -4, 0 }, { 0, 4 } }
				for i, sec in ipairs(DMG_MUT) do
					local ok, se = pcall(function() return alife():create(sec, vector():set(ap.x + off[i][1], ap.y + 0.3, ap.z + off[i][2]), a:level_vertex_id(), a:game_vertex_id()) end)
					if ok and se then dmg_spawned[#dmg_spawned + 1] = { id = se.id, sec = sec }; m(string.format("DMG_SPAWN,%d,%d,%s", now, se.id, sec))
					else m(string.format("DMG_SPAWN_ERROR,%d,%s,%s", now, sec, tostring(se))) end
				end
			else
				local ok, tg, d = pcall(dmg_find, cur)
				if ok and tg then dmg_tgt = tg; dmg_hold = true
					m(string.format("DMG_TARGET,%s,%d,%d,%s,%s,%.3f,%.3f,%.3f,%.1f", cur, now, tg.id, tg.name, tg.sec, tg.pos.x, tg.pos.y, tg.pos.z, d))
				else m(string.format("DMG_NOTARGET,%s,%d,%s", cur, now, tostring(tg))) end
			end
			if meta then meta:flush() end
		end
	end
	if not dmg_phase then return end
	local h = a.health; local ok, r, b = pcall(function() return a.radiation, a.bleeding end); if not ok or not r or not b then r, b = -1, -1 end
	if h < dmg_ph.minh then dmg_ph.minh = h end; if r > dmg_ph.maxr then dmg_ph.maxr = r end; if b > dmg_ph.maxb then dmg_ph.maxb = b end
	if dmg_mode == "god_off_norefill" and h < 0.7 then m(string.format("DMG_FLOOR,%s,%d,%.3f", dmg_phase, now, h)); a:set_health_ex(1.0) end   -- a death ends the run (first try: died at floor 0.2)
	if dmg_tgt then a:set_actor_position(vector():set(dmg_tgt.pos.x, dmg_tgt.pos.y, dmg_tgt.pos.z), true) end
	if now - dmg_last < 1000 then return end
	dmg_last = now
	if dmg_tgt then
		m(string.format("DMG_AT,%s,%d,%.2f,%d,%.4f,%.4f,%.4f", dmg_phase, now, a:position():distance_to(dmg_tgt.pos), level.object_by_id(dmg_tgt.id) and 1 or 0, h, r, b))
	else
		for _, s in ipairs(dmg_spawned) do
			local o = level.object_by_id(s.id); local d, al, en = -1, -1, -2
			if o then d = o:position():distance_to(a:position()); al = o:alive() and 1 or 0
				local okb, be = pcall(function() return o:best_enemy() end); en = (okb and be) and be:id() or -1 end
			m(string.format("DMG_MUT,%d,%d,%s,%.2f,%d,%d,%.4f,%.4f,%.4f", now, s.id, s.sec, d, al, en, h, r, b))
		end
	end
end
local on_quit
local function on_update()
	local a = db.actor; if not a then return end
	local now = time_global()
	do local ok, r, b = pcall(function() return a.radiation, a.bleeding end)   -- T3: "the actor takes no damage from anything" (report)
		if ok and r and b then if r > vit_rad then vit_rad = r end; if b > vit_bleed then vit_bleed = b end else vit_na = vit_na + 1 end end
	do local k = mvstate(); mv_frames = mv_frames + 1
		if k == 1 then mv_crouch = mv_crouch + 1 elseif k == 2 then mv_low = mv_low + 1 elseif k < 0 then mv_na = mv_na + 1 end end
	if not t0 then
		if not t2 and not load_track() then active = false; return end
		t0 = now + WAIT_MS
		if t2 then   -- R3: the changers of this level, and the resume line after a level change
			if t3_crossed then m(string.format("CROSS_RESUME,%d,%s,%s", now, level.name(), t3_crossed)) end
			local ok, L = pcall(t3_changers)
			if not ok then m("CHANGER_ERROR," .. tostring(L)) else for _, c in ipairs(L) do if c.from == level.name() or c.to == level.name() then
				m(string.format("CHANGER,%s,%s,%s,%.3f,%.3f,%.3f,%d,%d", c.name, c.from, c.to, c.pos.x, c.pos.y, c.pos.z, c.lvid, c.gvid)) end end end
		end
		if dmg_mode then m("DMG_MODE," .. dmg_mode) end
		get_console():execute((dmg_mode and dmg_mode ~= "prot") and "g_god off" or "g_god on")   -- retry amendment: engine-level god mode (registered with -dbg)
		if t2 and t2_absorb > 0 then get_console():execute("g_freeze_absorb_ms " .. t2_absorb); m(string.format("ABSORB_ON,%d,%d", now, t2_absorb)) end
		m(string.format("S,%d,actor_id=%d,switch_distance_at_load=%.1f,export=%s,wait_ms=%d,g_god=%s", now, a:id(), alife():switch_distance(), tostring(do_export), WAIT_MS, tostring(get_console():get_bool("g_god"))))
	end
	if a.health < min_health then min_health = a.health end
	-- retry amendment: refill to 1.0 on EVERY update (god mode does not block set_health_ex, which GAMMA's balancer uses);
	-- REFILL lines only for drops below 0.5
	if dmg_mode ~= "god_off_norefill" then
	if a.health < 0.5 then refills = refills + 1; m(string.format("REFILL,%.2f,%d,%.3f", (now - t0) / 1000, now, a.health)) end
	if a.health < 1.0 then a:set_health_ex(1.0) end
	end
	local t = (now - t0) / 1000
	if t2 then   -- B1-T2: no track; the pose drives the actor once the warm-up is over (t >= 0)
		-- long-stop check (Overseer, pre-flight 2): once a second G,<time_global>,<os.time>,<frame>,<game.time ms>,<alife objects>;
		-- after a wall-clock gap >= 2 s between updates (a SIGSTOP), RESUMED_GAP plus F,<time_global>,<f_time_delta ms> for every
		-- frame of the next 30 s of wall time
		local wall = os.time()
		if g_last_wall and wall - g_last_wall >= 2 then   -- >= 2 s so the 3 s hitch check (pre-flight 3) is seen too
			m(string.format("RESUMED_GAP,%d,%d,%d,%.0f,%d,%.0f", now, wall, wall - g_last_wall, gtime(), g_prev_tg or -1, g_prev_game or -1)); if meta then meta:flush() end; g_f_until = wall + 30 end
		g_last_wall = wall; g_prev_tg = now; g_prev_game = gtime()   -- this frame, for the next gap
		if g_f_until and wall <= g_f_until then m(string.format("F,%d,%.1f", now, device().f_time_delta * 1000)) end
		if now - (g_last_g or -1e9) >= 1000 then g_last_g = now
			m(string.format("G,%d,%d,%d,%.0f,%d", now, wall, device().frame, gtime(), alife():object_count())) end
		if dmg_mode and t >= 0 then dmg_step(a, now, t) end
		if t >= 0 then t2_pose(a, now, t) end
		if do_export and now - last_exp >= 100 then last_exp = now; export(now, t) end
		return
	end
	if t > trk_t[#trk_t] then if not done_logged then done_logged = true; m(string.format("TRACK_END,%.2f,%d", t, now)); on_quit() end; return end
	if now - last_move >= 50 then
		last_move = now
		local x, y, z = track_pos(math.max(0, t))
		if x then a:set_actor_position(vector():set(x, y, z)) end
	end
	if do_export and now - last_exp >= 100 then last_exp = now; export(now, t) end
end

local function on_before_hit(s_hit, bone_id, flags)
	hits = hits + 1
	local d = s_hit and s_hit.draftsman
	w(string.format("h,%.2f,%d,%s,%s,%d,%.4f,%s", t0 and (time_global() - t0) / 1000 or -1e9,
		d and d:id() or -1, d and d:section() or "none", kind(d), s_hit and s_hit.type or -1, s_hit and s_hit.power or -1, tostring(bone_id)))
	if out then out:flush() end
	if dmg_mode and dmg_mode ~= "prot" then return end   -- pre-flight E witness: log only, the hit goes through
	flags.ret_value = false; if s_hit then s_hit.power = 0 end; cancels = cancels + 1   -- as momo_multihit_fix.script
end

on_quit = function()
	if not out then return end
	table.sort(exp_times)
	local p99 = exp_n > 0 and exp_times[math.max(1, math.ceil(exp_n * 0.99))] or 0
	m(string.format("SUMMARY,hits=%d,cancelled=%d,refills=%d,min_health=%.3f,export_ticks=%d,export_mean_us=%.1f,export_p99_us=%.1f,export_max_us=%.1f",
		hits, cancels, refills, min_health, exp_n, exp_n > 0 and exp_sum / exp_n or 0, p99, exp_max))
	if t2 then t2_disarm(time_global(), p_last, "end") end
	if t2 then m(string.format("T2SUM,last_seq=%d,torn=%d,holds=%d,paused=%s,near=%d,guards=%d", p_last, p_torn, p_holds, tostring(p_paused), p_near, t3_guards)) end
	do local a = db.actor; local api = "na"
		if a and a.get_actor_stance then local ok, v = pcall(a.get_actor_stance, a); api = ok and tostring(v) or "err" end
		m(string.format("VITALS,min_health=%.3f,max_radiation=%.4f,max_bleeding=%.4f,unread=%d", min_health, vit_rad, vit_bleed, vit_na))
		m(string.format("MOVESUM,frames=%d,crouch=%d,low=%d,unread=%d,stance_api=%s", mv_frames, mv_crouch, mv_low, mv_na, api)) end
	out:close(); meta:close(); out, meta = nil, nil
end

function on_game_start()
	if not active then return end
	out = io.open(DIR .. (b1 and "hits_" or "export_") .. tag .. ".csv", "w")
	if not out then printf("p1: CANNOT OPEN EXPORT FILE"); active = false; return end
	-- R3: a level change restarts the Lua state. The marker written before ChangeLevel says "continue the same log".
	-- (the marker is emptied, not removed: an empty marker counts as none)
	do local f = io.open(DIR .. "cross.txt", "rb"); if f then local l = (f:read("*l") or ""):gsub("\r", ""); f:close()
		if l ~= "" then t3_crossed = l; f = io.open(DIR .. "cross.txt", "wb"); if f then f:close() end end end end
	do local f = io.open(DIR .. "dmgtest.txt", "rb"); if f then local l = (f:read("*l") or ""):gsub("%s", ""); f:close()
		if l == "prot" or l == "god_off" or l == "god_off_norefill" then dmg_mode = l end end end
	meta = io.open(DIR .. "meta_" .. tag .. ".csv", t3_crossed and "a" or "w")
	if not meta then printf("p1: CANNOT OPEN META FILE"); active = false; return end
	RegisterScriptCallback("actor_on_update", on_update)
	RegisterScriptCallback("actor_on_before_hit", on_before_hit)
	RegisterScriptCallback("actor_on_hit_callback", function() if db.actor and db.actor.health < (dmg_mode == "god_off_norefill" and 0.7 or 1.0) then db.actor:set_health_ex(1.0) end end)  -- second refill point, after each hit
	RegisterScriptCallback("on_before_level_changing", on_quit)
	RegisterScriptCallback("actor_on_net_destroy", on_quit)   -- "on_game_end" is not a callback in this GAMMA build (prereg section 30)
	-- summary also every 60 s of track time so a killed run keeps it
	local last_sum = 0
	RegisterScriptCallback("actor_on_update", function()
		if t0 and time_global() - last_sum >= 60000 then last_sum = time_global()
			m(string.format("TICK,%.2f,hits=%d,cancelled=%d,refills=%d,min_health=%.3f,export_ticks=%d,export_mean_us=%.1f,export_max_us=%.1f,held=%s",
				(last_sum - t0) / 1000, hits, cancels, refills, min_health, exp_n, exp_n > 0 and exp_sum / exp_n or 0, exp_max, tostring(held))); if meta then meta:flush() end end
	end)
end
